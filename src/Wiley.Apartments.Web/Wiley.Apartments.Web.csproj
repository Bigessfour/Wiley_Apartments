<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Wiley.Apartments.Domain\Wiley.Apartments.Domain.csproj" />
    <ProjectReference Include="..\Wiley.Apartments.Contracts\Wiley.Apartments.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.Cards" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Blazor.WordProcessor" Version="34.2.2" />
    <PackageReference Include="Syncfusion.DocIO.Net.Core" Version="34.2.2" />
    <PackageReference Include="Syncfusion.DocIORenderer.Net.Core" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="34.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>wiley-apartments-clerksuite-dev</UserSecretsId>
    <!-- App.razor is the Blazor Web App document root; scripts belong there (RZ9992 false positive). -->
    <NoWarn>$(NoWarn);RZ9992</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wiley.Apartments.Tests" />
    <InternalsVisibleTo Include="Wiley.Apartments.IntegrationTests" />
  </ItemGroup>

</Project>
