{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/clerksuite.db"
  },
  "ClerkSuite": {
    "DatabaseProvider": "Sqlite",
    "DocumentRoot": "/docs",
    "PaymentPortalUrl": "https://www.townofwiley.gov/government/departments/finance/utility-billing",
    "LateFeesEnabled": false,
    "LateFeeAmount": 0,
    "LateFeeGraceDays": 0
  },
  "SeedUsers": {
    "Users": []
  },
  "Serilog": {
    "WriteToConsole": true,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Components": "Information",
        "Microsoft.AspNetCore.Components.Server": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
