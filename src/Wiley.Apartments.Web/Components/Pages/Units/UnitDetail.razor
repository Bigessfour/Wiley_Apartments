@page "/units/{UnitId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Navigations
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@using Wiley.Apartments.Web.Components.Shared
@inject IUnitService UnitService
@inject IAssetService AssetService
@inject IFlooringService FlooringService
@inject IOccupancyService OccupancyService
@inject ITenantService TenantService
@inject IUnitOperatingCostService OpsCostService
@inject IMaintenanceService MaintenanceService
@inject IDateTimeService Clock
@inject NavigationManager Navigation

<PageTitle>Unit @Unit?.Number</PageTitle>

@if (LoadError is not null)
{
    <div class="alert alert-danger">@LoadError</div>
}
else if (Unit is null)
{
    <p>Loading unit…</p>
}
else
{
    <PageHeader Title="@($"Unit {Unit.Number}")" Subtitle="Complete unit inventory and status">
        <SfButton CssClass="e-outline" Content="Back to units" OnClick="GoToUnitList" />
    </PageHeader>

    @if (!string.IsNullOrEmpty(GridError))
    {
        <div class="alert alert-warning">@GridError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <SfCard CssClass="unit-summary-card h-100">
                <CardHeader Title="Status & layout" />
                <CardContent>
                    <p class="mb-2">
                        <UnitStatusChip Status="Unit.Status" />
                    </p>
                    <p class="mb-1">@Unit.Beds bed · @Unit.Baths bath</p>
                    <p class="mb-0 text-muted">@Unit.SqFt.ToString("N0") sq ft</p>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-md-6 col-xl-3">
            <SfCard CssClass="unit-summary-card h-100">
                <CardHeader Title="Assets & appliances" />
                <CardContent>
                    <p class="unit-summary-value mb-1">@UnitAssets.Count</p>
                    <p class="mb-0 text-muted">
                        @if (ExpiringWarrantyCount > 0)
                        {
                            <span>@ExpiringWarrantyCount warranty@(ExpiringWarrantyCount == 1 ? "" : "ies") expiring within 90 days</span>
                        }
                        else
                        {
                            <span>No warranties expiring soon</span>
                        }
                    </p>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-md-6 col-xl-3">
            <SfCard CssClass="unit-summary-card h-100">
                <CardHeader Title="Flooring & carpet" />
                <CardContent>
                    <p class="unit-summary-value mb-1">@UnitFloorings.Count</p>
                    <p class="mb-0 text-muted">@CurrentFlooringSummary</p>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-md-6 col-xl-3">
            <SfCard CssClass="unit-summary-card h-100">
                <CardHeader Title="Current tenant" />
                <CardContent>
                    @if (CurrentOccupancy?.Tenant is not null)
                    {
                        <p class="mb-1">
                            <a href="@($"/tenants/{CurrentOccupancy.TenantId}")">
                                @CurrentOccupancy.Tenant.LastName, @CurrentOccupancy.Tenant.FirstName
                            </a>
                        </p>
                        <p class="mb-0 text-muted small">Since @Clock.ToDisplayTime(CurrentOccupancy.StartUtc).ToString("g") MT</p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Vacant — no active occupancy</p>
                    }
                </CardContent>
            </SfCard>
        </div>
    </div>

    <SfTab>
        <TabItems>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Occupancy"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    @if (!string.IsNullOrEmpty(OccupancyError))
                    {
                        <div class="alert alert-warning">@OccupancyError</div>
                    }

                    <div class="row g-3 mb-3 align-items-end">
                        @if (CurrentOccupancy is null)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Start occupancy</label>
                                <SfDropDownList TValue="Guid?"
                                                TItem="TenantOption"
                                                DataSource="@TenantOptions"
                                                @bind-Value="SelectedTenantId"
                                                Placeholder="Select tenant"
                                                AllowFiltering="true">
                                    <DropDownListFieldSettings Value="Id" Text="DisplayName" />
                                </SfDropDownList>
                            </div>
                            <div class="col-md-3">
                                <SfButton CssClass="e-primary"
                                          Content="Start occupancy"
                                          Disabled="@(SelectedTenantId is null)"
                                          OnClick="StartOccupancyAsync" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <p class="mb-2">
                                    Active: <strong>@CurrentOccupancy.Tenant!.LastName, @CurrentOccupancy.Tenant.FirstName</strong>
                                </p>
                                <SfButton CssClass="e-outline e-danger"
                                          Content="End occupancy"
                                          OnClick="EndOccupancyAsync" />
                            </div>
                        }
                    </div>

                    <h2 class="h6 mb-2">Occupancy history</h2>
                    <SfGrid TValue="Occupancy"
                            DataSource="@OccupancyHistory"
                            AllowPaging="true"
                            AllowSorting="true"
                            Height="280">
                        <GridColumns>
                            <GridColumn HeaderText="Tenant" Width="180">
                                <Template>
                                    @{
                                        var row = (Occupancy)context;
                                        var name = row.Tenant is null
                                            ? row.TenantId.ToString()[..8]
                                            : $"{row.Tenant.LastName}, {row.Tenant.FirstName}";
                                    }
                                    <span>@name</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Start (MT)" Width="160">
                                <Template>
                                    @{
                                        var row = (Occupancy)context;
                                    }
                                    <span>@Clock.ToDisplayTime(row.StartUtc).ToString("g")</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="End (MT)" Width="160">
                                <Template>
                                    @{
                                        var row = (Occupancy)context;
                                    }
                                    <span>@(row.EndUtc is null ? "Active" : Clock.ToDisplayTime(row.EndUtc.Value).ToString("g"))</span>
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Overview"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <h2 class="h6 mb-2">Assets & appliances</h2>
                            <SfGrid TValue="Asset"
                                    DataSource="@UnitAssets"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    Height="280">
                                <GridColumns>
                                    <GridColumn Field="@nameof(Asset.Type)" HeaderText="Type" Width="120" />
                                    <GridColumn Field="@nameof(Asset.Make)" HeaderText="Make" Width="100" />
                                    <GridColumn Field="@nameof(Asset.Model)" HeaderText="Model" Width="100" />
                                    <GridColumn Field="@nameof(Asset.Serial)" HeaderText="Serial" Width="120" />
                                    <GridColumn Field="@nameof(Asset.WarrantyEnd)"
                                                HeaderText="Warranty end"
                                                Format="d"
                                                Width="120" />
                                    <GridColumn Field="@nameof(Asset.Condition)" HeaderText="Condition" Width="110" />
                                </GridColumns>
                            </SfGrid>
                        </div>
                        <div class="col-lg-6">
                            <h2 class="h6 mb-2">Flooring history</h2>
                            <SfGrid TValue="Flooring"
                                    DataSource="@UnitFloorings"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    Height="280">
                                <GridColumns>
                                    <GridColumn Field="@nameof(Flooring.Type)" HeaderText="Type / material" Width="140" />
                                    <GridColumn Field="@nameof(Flooring.InstallDate)"
                                                HeaderText="Installed"
                                                Format="d"
                                                Width="110" />
                                    <GridColumn Field="@nameof(Flooring.Condition)" HeaderText="Condition" Width="110" />
                                    <GridColumn Field="@nameof(Flooring.ReplacedDate)"
                                                HeaderText="Replaced"
                                                Format="d"
                                                Width="110" />
                                    <GridColumn Field="@nameof(Flooring.Notes)" HeaderText="Notes" Width="160" />
                                </GridColumns>
                            </SfGrid>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Manage assets"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <SfGrid @ref="AssetGridRef"
                            TValue="Asset"
                            DataSource="@UnitAssets"
                            Toolbar="@AssetToolbar"
                            AllowPaging="true"
                            AllowSorting="true"
                            Height="360">
                        <GridEvents TValue="Asset"
                                    OnActionBegin="OnAssetActionBeginAsync"
                                    OnActionComplete="OnAssetActionCompleteAsync" />
                        <GridEditSettings AllowAdding="true"
                                          AllowEditing="true"
                                          AllowDeleting="true"
                                          Mode="EditMode.Normal"
                                          ShowDeleteConfirmDialog="true" />
                        <GridColumns>
                            <GridColumn Field="@nameof(Asset.Id)"
                                        IsPrimaryKey="true"
                                        Visible="false" />
                            <GridColumn Field="@nameof(Asset.Type)"
                                        HeaderText="Type"
                                        Width="120"
                                        ValidationRules="@(new ValidationRules { Required = true })" />
                            <GridColumn Field="@nameof(Asset.Make)" HeaderText="Make" Width="110" />
                            <GridColumn Field="@nameof(Asset.Model)" HeaderText="Model" Width="110" />
                            <GridColumn Field="@nameof(Asset.Serial)"
                                        HeaderText="Serial"
                                        Width="130"
                                        ValidationRules="@(new ValidationRules { Required = true })" />
                            <GridColumn Field="@nameof(Asset.InstallDate)"
                                        HeaderText="Installed"
                                        EditType="EditType.DatePickerEdit"
                                        Format="d"
                                        Width="120" />
                            <GridColumn Field="@nameof(Asset.WarrantyStart)"
                                        HeaderText="Warranty start"
                                        EditType="EditType.DatePickerEdit"
                                        Format="d"
                                        Width="130" />
                            <GridColumn Field="@nameof(Asset.WarrantyEnd)"
                                        HeaderText="Warranty end"
                                        EditType="EditType.DatePickerEdit"
                                        Format="d"
                                        Width="130" />
                            <GridColumn Field="@nameof(Asset.Condition)" HeaderText="Condition" Width="110" />
                            <GridColumn Field="@nameof(Asset.Notes)" HeaderText="Notes" Width="180" />
                        </GridColumns>
                    </SfGrid>
                    <div class="mt-3">
                        <label class="form-label">Asset documents (manuals, receipts, photos)</label>
                        <SfDropDownList TValue="Guid?" TItem="AssetFilterOption" DataSource="@AssetFilterOptions"
                                        @bind-Value="DocumentAssetId" Placeholder="Select asset" AllowFiltering="true">
                            <DropDownListFieldSettings Text="Text" Value="Id" />
                        </SfDropDownList>
                        @if (DocumentAssetId is Guid docAssetId)
                        {
                            <EntityDocumentsPanel EntityType="DocumentEntityType.Asset"
                                                  EntityId="docAssetId"
                                                  Title="Asset attachments"
                                                  RelativeDirectory="assets"
                                                  DefaultCategory="DocumentCategory.Manual" />
                        }
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Manage flooring"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <SfGrid @ref="FlooringGridRef"
                            TValue="Flooring"
                            DataSource="@UnitFloorings"
                            Toolbar="@FlooringToolbar"
                            AllowPaging="true"
                            AllowSorting="true"
                            Height="360">
                        <GridEvents TValue="Flooring"
                                    OnActionBegin="OnFlooringActionBeginAsync"
                                    OnActionComplete="OnFlooringActionCompleteAsync" />
                        <GridEditSettings AllowAdding="true"
                                          AllowEditing="true"
                                          AllowDeleting="true"
                                          Mode="EditMode.Normal"
                                          ShowDeleteConfirmDialog="true" />
                        <GridColumns>
                            <GridColumn Field="@nameof(Flooring.Id)"
                                        IsPrimaryKey="true"
                                        Visible="false" />
                            <GridColumn Field="@nameof(Flooring.Type)"
                                        HeaderText="Type / material"
                                        Width="160"
                                        ValidationRules="@(new ValidationRules { Required = true })" />
                            <GridColumn Field="@nameof(Flooring.InstallDate)"
                                        HeaderText="Installed"
                                        EditType="EditType.DatePickerEdit"
                                        Format="d"
                                        Width="120" />
                            <GridColumn Field="@nameof(Flooring.Condition)"
                                        HeaderText="Condition"
                                        Width="120" />
                            <GridColumn Field="@nameof(Flooring.ReplacedDate)"
                                        HeaderText="Replaced"
                                        EditType="EditType.DatePickerEdit"
                                        Format="d"
                                        Width="120" />
                            <GridColumn Field="@nameof(Flooring.Notes)"
                                        HeaderText="Notes"
                                        Width="200" />
                        </GridColumns>
                    </SfGrid>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Maintenance"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="d-flex justify-content-between align-items-end mb-2 flex-wrap gap-2">
                        <p class="text-muted small mb-0">
                            Work-order history for this unit.
                            <a href="/maintenance">All maintenance</a>
                        </p>
                        <div style="min-width: 220px;">
                            <label class="form-label small mb-1">Filter by asset</label>
                            <SfDropDownList TValue="Guid?" TItem="AssetFilterOption"
                                            DataSource="@AssetFilterOptions"
                                            Placeholder="All (unit + assets)"
                                            ShowClearButton="true"
                                            @bind-Value="MaintenanceAssetFilter"
                                            ValueChange="OnMaintenanceAssetFilterChanged">
                                <DropDownListFieldSettings Text="Text" Value="Id" />
                            </SfDropDownList>
                        </div>
                    </div>
                    <SfGrid TValue="MaintenanceRow" DataSource="@DisplayedMaintenanceRows" AllowPaging="true" AllowSorting="true" Height="360">
                        <GridPageSettings PageSize="10" />
                        <GridColumns>
                            <GridColumn Field="@nameof(MaintenanceRow.CreatedDisplay)" HeaderText="Created" Width="110" />
                            <GridColumn Field="@nameof(MaintenanceRow.AssetLabel)" HeaderText="Asset" Width="140" />
                            <GridColumn Field="@nameof(MaintenanceRow.Priority)" HeaderText="Priority" Width="100" />
                            <GridColumn Field="@nameof(MaintenanceRow.Status)" HeaderText="Status" Width="110" />
                            <GridColumn Field="@nameof(MaintenanceRow.Description)" HeaderText="Description" />
                            <GridColumn Field="@nameof(MaintenanceRow.Cost)" HeaderText="Cost" Format="C2" Width="100" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(MaintenanceRow.CompletedDisplay)" HeaderText="Completed" Width="110" />
                        </GridColumns>
                    </SfGrid>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Ops costs"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <p class="text-muted small mb-0">
                            Landlord expenses for this unit (Utility / Repair / Replace / CommonUpkeep).
                            Full portfolio entry: <a href="/reports/operating-costs">Operating costs report</a>.
                        </p>
                        <span class="fw-semibold">Total @OpsCostTotal.ToString("C")</span>
                    </div>
                    <SfGrid TValue="OpsCostRow" DataSource="@OpsCostRows" AllowPaging="true" AllowSorting="true" Height="360">
                        <GridPageSettings PageSize="10" />
                        <GridColumns>
                            <GridColumn Field="@nameof(OpsCostRow.DateDisplay)" HeaderText="Date" Width="110" />
                            <GridColumn Field="@nameof(OpsCostRow.Category)" HeaderText="Category" Width="120" />
                            <GridColumn Field="@nameof(OpsCostRow.Amount)" HeaderText="Amount" Format="C2" Width="110" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(OpsCostRow.Vendor)" HeaderText="Vendor" Width="140" />
                            <GridColumn Field="@nameof(OpsCostRow.Notes)" HeaderText="Notes" />
                        </GridColumns>
                    </SfGrid>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
}

@code {
    [Parameter]
    public Guid UnitId { get; set; }

    private Unit? Unit { get; set; }
    private List<Asset> UnitAssets { get; set; } = [];
    private List<Flooring> UnitFloorings { get; set; } = [];
    private List<OpsCostRow> OpsCostRows { get; set; } = [];
    private decimal OpsCostTotal { get; set; }
    private List<MaintenanceRow> MaintenanceRows { get; set; } = [];
    private List<MaintenanceRow> DisplayedMaintenanceRows { get; set; } = [];
    private List<AssetFilterOption> AssetFilterOptions { get; set; } = [];
    private Guid? MaintenanceAssetFilter { get; set; }
    private Guid? DocumentAssetId { get; set; }
    private Occupancy? CurrentOccupancy { get; set; }
    private List<Occupancy> OccupancyHistory { get; set; } = [];
    private List<TenantOption> TenantOptions { get; set; } = [];
    private Guid? SelectedTenantId { get; set; }
    private SfGrid<Asset>? AssetGridRef;
    private SfGrid<Flooring>? FlooringGridRef;
    private string? LoadError { get; set; }
    private string? GridError { get; set; }
    private string? OccupancyError { get; set; }

    private int ExpiringWarrantyCount => UnitAssets.Count(a =>
        a.WarrantyEnd is not null
        && a.WarrantyEnd >= DateOnly.FromDateTime(DateTime.UtcNow)
        && a.WarrantyEnd <= DateOnly.FromDateTime(DateTime.UtcNow.AddDays(90)));

    private string CurrentFlooringSummary
    {
        get
        {
            var current = UnitFloorings.FirstOrDefault(f => f.ReplacedDate is null)
                ?? UnitFloorings.FirstOrDefault();
            if (current is null)
            {
                return "No flooring records yet.";
            }

            var installed = current.InstallDate?.ToString("d") ?? "unknown date";
            return $"{current.Type} · installed {installed}";
        }
    }

    private readonly List<string> AssetToolbar =
    [
        "Add", "Edit", "Delete", "Update", "Cancel", "Search"
    ];

    private readonly List<string> FlooringToolbar =
    [
        "Add", "Edit", "Delete", "Update", "Cancel", "Search"
    ];

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        LoadError = null;
        Unit = await UnitService.GetByIdAsync(UnitId);
        if (Unit is null)
        {
            LoadError = "Unit not found.";
            return;
        }

        UnitAssets = (await AssetService.GetByUnitIdAsync(UnitId)).ToList();
        UnitFloorings = (await FlooringService.GetByUnitIdAsync(UnitId)).ToList();
        await ReloadOpsCostsAsync();
        await ReloadMaintenanceAsync();
        await ReloadOccupancyAsync();
        TenantOptions = (await TenantService.SearchAsync())
            .Select(t => new TenantOption(t.Id, $"{t.LastName}, {t.FirstName}"))
            .ToList();
    }

    private async Task ReloadOpsCostsAsync()
    {
        var costs = await OpsCostService.QueryAsync(unitId: UnitId);
        OpsCostRows = costs.Select(c => new OpsCostRow(
            Clock.ToDisplayTime(c.IncurredUtc).ToString("d"),
            c.Category.ToString(),
            c.Amount,
            c.Vendor ?? "",
            c.Notes ?? "")).ToList();
        OpsCostTotal = OpsCostRows.Sum(r => r.Amount);
    }

    private async Task ReloadMaintenanceAsync()
    {
        var items = await MaintenanceService.GetForUnitAsync(UnitId);
        MaintenanceRows = items.Select(ToMaintenanceRow).ToList();
        AssetFilterOptions = UnitAssets
            .Select(a => new AssetFilterOption { Id = a.Id, Text = $"{a.Type} ({a.Serial})" })
            .ToList();
        ApplyMaintenanceFilter();
    }

    private void ApplyMaintenanceFilter()
    {
        DisplayedMaintenanceRows = MaintenanceAssetFilter is Guid aid
            ? MaintenanceRows.Where(r => r.AssetId == aid).ToList()
            : MaintenanceRows;
    }

    private async Task OnMaintenanceAssetFilterChanged(Syncfusion.Blazor.DropDowns.ChangeEventArgs<Guid?, AssetFilterOption> args)
    {
        MaintenanceAssetFilter = args.Value;
        ApplyMaintenanceFilter();
        await Task.CompletedTask;
    }

    private MaintenanceRow ToMaintenanceRow(MaintenanceRequest m) => new(
        m.Id,
        m.AssetId,
        Clock.ToDisplayTime(m.CreatedUtc).ToString("d"),
        m.Asset is null ? "(Unit)" : $"{m.Asset.Type} ({m.Asset.Serial})",
        m.Priority.ToString(),
        m.Status.ToString(),
        m.Description,
        m.Cost,
        m.CompletedUtc is DateTime c ? Clock.ToDisplayTime(c).ToString("d") : "");

    private async Task ReloadOccupancyAsync()
    {
        CurrentOccupancy = await OccupancyService.GetCurrentForUnitAsync(UnitId);
        OccupancyHistory = (await OccupancyService.GetHistoryForUnitAsync(UnitId)).ToList();
        Unit = await UnitService.GetByIdAsync(UnitId);
    }

    private async Task StartOccupancyAsync()
    {
        OccupancyError = null;
        if (SelectedTenantId is null)
        {
            OccupancyError = "Select a tenant first.";
            return;
        }

        try
        {
            await OccupancyService.StartAsync(UnitId, SelectedTenantId.Value);
            SelectedTenantId = null;
            await ReloadOccupancyAsync();
        }
        catch (Exception ex)
        {
            OccupancyError = ex.Message;
        }
    }

    private async Task EndOccupancyAsync()
    {
        OccupancyError = null;
        try
        {
            await OccupancyService.EndAsync(UnitId);
            await ReloadOccupancyAsync();
        }
        catch (Exception ex)
        {
            OccupancyError = ex.Message;
        }
    }

    private void GoToUnitList() => Navigation.NavigateTo("/units");

    private async Task OnAssetActionBeginAsync(ActionEventArgs<Asset> args)
    {
        GridError = null;
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Add && args.Data is not null)
        {
            args.Data.UnitId = UnitId;
            args.Data.Id = Guid.NewGuid();
        }

        await Task.CompletedTask;
    }

    private async Task OnAssetActionCompleteAsync(ActionEventArgs<Asset> args)
    {
        try
        {
            switch (args.RequestType)
            {
                case Syncfusion.Blazor.Grids.Action.Save when args.Action == "Add" && args.Data is not null:
                    args.Data.UnitId = UnitId;
                    await AssetService.CreateAsync(args.Data);
                    break;
                case Syncfusion.Blazor.Grids.Action.Save when args.Action == "Edit" && args.Data is not null:
                    await AssetService.UpdateAsync(args.Data);
                    break;
                case Syncfusion.Blazor.Grids.Action.Delete when args.Data is not null:
                    await AssetService.DeleteAsync(args.Data.Id);
                    break;
                default:
                    return;
            }

            await ReloadInventoryAsync();
            if (AssetGridRef is not null)
            {
                await AssetGridRef.Refresh();
            }
        }
        catch (Exception ex)
        {
            GridError = ex.Message;
            await ReloadInventoryAsync();
            if (AssetGridRef is not null)
            {
                await AssetGridRef.Refresh();
            }
        }
    }

    private async Task OnFlooringActionBeginAsync(ActionEventArgs<Flooring> args)
    {
        GridError = null;
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Add && args.Data is not null)
        {
            args.Data.UnitId = UnitId;
            args.Data.Id = Guid.NewGuid();
        }

        await Task.CompletedTask;
    }

    private async Task OnFlooringActionCompleteAsync(ActionEventArgs<Flooring> args)
    {
        try
        {
            switch (args.RequestType)
            {
                case Syncfusion.Blazor.Grids.Action.Save when args.Action == "Add" && args.Data is not null:
                    args.Data.UnitId = UnitId;
                    await FlooringService.CreateAsync(args.Data);
                    break;
                case Syncfusion.Blazor.Grids.Action.Save when args.Action == "Edit" && args.Data is not null:
                    await FlooringService.UpdateAsync(args.Data);
                    break;
                case Syncfusion.Blazor.Grids.Action.Delete when args.Data is not null:
                    await FlooringService.DeleteAsync(args.Data.Id);
                    break;
                default:
                    return;
            }

            await ReloadInventoryAsync();
            if (FlooringGridRef is not null)
            {
                await FlooringGridRef.Refresh();
            }
        }
        catch (Exception ex)
        {
            GridError = ex.Message;
            await ReloadInventoryAsync();
            if (FlooringGridRef is not null)
            {
                await FlooringGridRef.Refresh();
            }
        }
    }

    private async Task ReloadInventoryAsync()
    {
        UnitAssets = (await AssetService.GetByUnitIdAsync(UnitId)).ToList();
        UnitFloorings = (await FlooringService.GetByUnitIdAsync(UnitId)).ToList();
    }

    private sealed record TenantOption(Guid Id, string DisplayName);

    private sealed record OpsCostRow(
        string DateDisplay,
        string Category,
        decimal Amount,
        string Vendor,
        string Notes);

    private sealed record MaintenanceRow(
        Guid Id,
        Guid? AssetId,
        string CreatedDisplay,
        string AssetLabel,
        string Priority,
        string Status,
        string Description,
        decimal? Cost,
        string CompletedDisplay);

    private sealed class AssetFilterOption
