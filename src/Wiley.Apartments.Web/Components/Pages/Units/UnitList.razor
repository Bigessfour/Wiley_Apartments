@page "/units"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@inject IUnitService UnitService
@inject NavigationManager Navigation
@inject ILogger<UnitList> Logger

<PageTitle>Units</PageTitle>

<PageHeader Title="Units"
            Subtitle="@Subtitle">
    <SfButton CssClass="e-outline e-small" Content="Community Center"
              OnClick="@(() => Navigation.NavigateTo("/community-center"))" />
</PageHeader>

<p class="small text-muted mb-2">
    Residential apartments only. Community Center (CC) is a facility — open it from Community Center, not this roster.
</p>

@if (!string.IsNullOrWhiteSpace(StatusFilter))
{
    <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 py-2" role="status">
        <span>Showing units with status <strong>@StatusFilterLabel</strong> (@Units.Count of @AllUnits.Count).</span>
        <SfButton CssClass="e-small e-outline" Content="Clear filter" OnClick="ClearStatusFilter" />
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}

<SfGrid @ref="GridRef"
        TValue="Unit"
        DataSource="@Units"
        Toolbar="@ToolbarItems"
        AllowPaging="true"
        AllowSorting="true"
        AllowFiltering="true"
        Height="420">
    <GridEvents TValue="Unit"
                OnActionBegin="OnActionBeginAsync"
                OnActionComplete="OnActionCompleteAsync" />
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridTemplates>
        <EmptyRecordTemplate>
            <div class="grid-empty-hint">No units yet — use Add on the toolbar.</div>
        </EmptyRecordTemplate>
    </GridTemplates>
    <GridEditSettings AllowAdding="@CanAddUnit"
                      AllowEditing="true"
                      AllowDeleting="true"
                      Mode="EditMode.Dialog"
                      ShowDeleteConfirmDialog="true" />
    <GridColumns>
        <GridColumn Field="@nameof(Unit.Id)"
                    IsPrimaryKey="true"
                    Visible="false"
                    AllowEditing="false" />
        <GridColumn Field="@nameof(Unit.RowVersion)"
                    Visible="false"
                    AllowEditing="false" />
        <GridColumn Field="@nameof(Unit.CurrentTenantId)"
                    Visible="false"
                    AllowEditing="false" />
        <GridColumn Field="@nameof(Unit.IsFacility)"
                    Visible="false"
                    AllowEditing="false" />
        <GridColumn Field="@nameof(Unit.Number)"
                    HeaderText="Unit #"
                    Width="100"
                    ValidationRules="@(new ValidationRules { Required = true })" />
        <GridColumn Field="@nameof(Unit.SqFt)"
                    HeaderText="Sq Ft"
                    TextAlign="TextAlign.Right"
                    Format="N0"
                    Width="110"
                    ValidationRules="@(new ValidationRules { Required = true, Min = 0 })">
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <div @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <SfNumericTextBox TValue="decimal"
                                      @bind-Value="unit.SqFt"
                                      Format="N0"
                                      Decimals="0"
                                      Min="0"
                                      Step="1"
                                      ShowSpinButton="true"
                                      Width="100%" />
                </div>
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(Unit.Beds)"
                    HeaderText="Beds"
                    TextAlign="TextAlign.Right"
                    Width="90"
                    ValidationRules="@(new ValidationRules { Required = true, Min = 0 })">
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <div @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <SfNumericTextBox TValue="int"
                                      @bind-Value="unit.Beds"
                                      Format="N0"
                                      Min="0"
                                      Step="1"
                                      ShowSpinButton="true"
                                      Width="100%" />
                </div>
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(Unit.Baths)"
                    HeaderText="Baths"
                    TextAlign="TextAlign.Right"
                    Width="90"
                    ValidationRules="@(new ValidationRules { Required = true, Min = 0 })">
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <div @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <SfNumericTextBox TValue="int"
                                      @bind-Value="unit.Baths"
                                      Format="N0"
                                      Min="0"
                                      Step="1"
                                      ShowSpinButton="true"
                                      Width="100%" />
                </div>
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(Unit.MonthlyRent)"
                    HeaderText="Rent"
                    TextAlign="TextAlign.Right"
                    Format="C2"
                    Width="110"
                    ValidationRules="@(new ValidationRules { Min = 0 })">
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <div @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <SfNumericTextBox TValue="decimal"
                                      @bind-Value="unit.MonthlyRent"
                                      Format="C2"
                                      Decimals="2"
                                      Min="0"
                                      Step="25"
                                      ShowSpinButton="true"
                                      Width="100%" />
                </div>
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(Unit.SecurityDeposit)"
                    HeaderText="Deposit"
                    TextAlign="TextAlign.Right"
                    Format="C2"
                    Width="110"
                    ValidationRules="@(new ValidationRules { Min = 0 })">
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <div @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <SfNumericTextBox TValue="decimal"
                                      @bind-Value="unit.SecurityDeposit"
                                      Format="C2"
                                      Decimals="2"
                                      Min="0"
                                      Step="25"
                                      ShowSpinButton="true"
                                      Width="100%" />
                </div>
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(Unit.LeaseTerm)"
                    HeaderText="Term"
                    Width="120" />
        <GridColumn Field="@nameof(Unit.IsHandicapAccessible)"
                    HeaderText="HC"
                    Width="70"
                    DisplayAsCheckBox="true"
                    EditType="EditType.BooleanEdit"
                    TextAlign="TextAlign.Center" />
        <GridColumn Field="@nameof(Unit.Status)"
                    HeaderText="Status"
                    Width="140"
                    EditType="EditType.DropDownEdit">
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <SfDropDownList TValue="UnitStatus"
                                TItem="UnitStatusOption"
                                DataSource="@StatusOptions"
                                @bind-Value="unit.Status">
                    <DropDownListFieldSettings Value="Value" Text="Text" />
                </SfDropDownList>
            </EditTemplate>
            <Template>
                @{
                    var row = (Unit)context;
                }
                <UnitStatusChip Status="row.Status" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(Unit.Notes)"
                    HeaderText="Layout notes"
                    Width="220">
            <Template>
                @{
                    var row = (Unit)context;
                    var notes = row.Notes ?? "";
                    var preview = notes.Length > 40 ? notes[..40] + "…" : notes;
                }
                <span title="@notes">@preview</span>
            </Template>
            <EditTemplate>
                @{
                    var unit = (Unit)context;
                }
                <div @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <SfTextBox @bind-Value="unit.Notes"
                               Multiline="true"
                               Placeholder="Floor plan, storage, layout notes"
                               Width="100%" />
                </div>
            </EditTemplate>
        </GridColumn>
        <GridColumn HeaderText=""
                    Width="90"
                    AllowEditing="false"
                    AllowAdding="false"
                    TextAlign="TextAlign.Center">
            <EditTemplate>
                <span></span>
            </EditTemplate>
            <Template>
                @{
                    var unit = context as Unit;
                }
                <SfButton CssClass="e-small e-outline"
                          Content="Open"
                          OnClick="@(() => OpenUnit(unit!.Id))" />
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    private SfGrid<Unit>? GridRef;
    private List<Unit> Units { get; set; } = [];
    private List<Unit> AllUnits { get; set; } = [];
    private string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusFilter { get; set; }

    private string StatusFilterLabel =>
        string.Equals(StatusFilter, "Empty", StringComparison.OrdinalIgnoreCase)
            ? "Vacant or Make-Ready"
            : StatusFilter ?? "";
    // Cap and portfolio counts must use the full set, not the status-filtered grid.
    private int ResidentialCount => AllUnits.Count;
    private bool CanAddUnit => UnitService.MaxUnits <= 0 || ResidentialCount < UnitService.MaxUnits;
    private string Subtitle
    {
        get
        {
            var residential = UnitService.MaxUnits > 0
                ? $"{ResidentialCount} of {UnitService.MaxUnits} residential"
                : $"{ResidentialCount} residential";
            var baseText = $"Town of Wiley — {residential} units. Edit layout, then Update. Open for inventory.";
            if (!string.IsNullOrWhiteSpace(StatusFilter))
            {
                return $"{baseText} Filter: {StatusFilterLabel}.";
            }

            return baseText;
        }
    }

    private readonly List<string> ToolbarItems =
    [
        "Add", "Edit", "Delete", "Update", "Cancel", "Search"
    ];

    private readonly List<UnitStatusOption> StatusOptions =
    [
        new(UnitStatus.Vacant, "Vacant"),
        new(UnitStatus.Occupied, "Occupied"),
        new(UnitStatus.Maintenance, "Maintenance"),
        new(UnitStatus.MakeReady, "Make-Ready")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        AllUnits = (await UnitService.GetResidentialAsync()).ToList();
        ApplyStatusFilter();
    }

    private void ApplyStatusFilter()
    {
        if (string.IsNullOrWhiteSpace(StatusFilter))
        {
            Units = AllUnits.ToList();
            return;
        }

        var wanted = StatusFilter.Trim().Replace("-", "", StringComparison.Ordinal);
        if (wanted.Equals("Empty", StringComparison.OrdinalIgnoreCase)
            || wanted.Equals("VacantOrMakeReady", StringComparison.OrdinalIgnoreCase))
        {
            Units = AllUnits
                .Where(u => u.Status is UnitStatus.Vacant or UnitStatus.MakeReady)
                .ToList();
            return;
        }
        Units = AllUnits.Where(u =>
        {
            var key = u.Status.ToString().Replace("-", "", StringComparison.Ordinal);
            return key.Equals(wanted, StringComparison.OrdinalIgnoreCase)
                   || (wanted.Equals("MakeReady", StringComparison.OrdinalIgnoreCase) && u.Status == UnitStatus.MakeReady);
        }).ToList();
    }

    private void OpenUnit(Guid unitId) => Navigation.NavigateTo($"/units/{unitId}");

    private void ClearStatusFilter()
    {
        StatusFilter = null;
        ApplyStatusFilter();
        Navigation.NavigateTo("/units");
    }

    private async Task OnActionBeginAsync(ActionEventArgs<Unit> args)
    {
        ErrorMessage = null;

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Add && args.Data is not null)
        {
            args.Data.IsFacility = false;
            if (args.Data.RowVersion == Guid.Empty)
            {
                args.Data.RowVersion = Guid.NewGuid();
            }
        }

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Add && !CanAddUnit)
        {
            args.Cancel = true;
            ErrorMessage = UnitService.MaxUnits > 0
                ? $"Portfolio is capped at {UnitService.MaxUnits} residential units (Community Center does not count). Ask IT to raise ClerkSuite:MaxUnits only if the town adds units."
                : "Cannot add unit right now.";
            return;
        }

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete && args.Data is not null
            && args.Data.IsFacility)
        {
            args.Cancel = true;
            ErrorMessage = "Community Center facility unit cannot be deleted.";
            return;
        }

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete && args.Data is not null
            && args.Data.Status == UnitStatus.Occupied)
        {
            args.Cancel = true;
            ErrorMessage = "Occupied units cannot be deleted.";
        }

        await Task.CompletedTask;
    }

    private async Task OnActionCompleteAsync(ActionEventArgs<Unit> args)
    {
        try
        {
            switch (args.RequestType)
            {
                case Syncfusion.Blazor.Grids.Action.Save when args.Action == "Add" && args.Data is not null:
                    await UnitService.CreateAsync(args.Data);
                    break;
                case Syncfusion.Blazor.Grids.Action.Save when args.Action == "Edit" && args.Data is not null:
                    var existing = await UnitService.GetByIdAsync(args.Data.Id)
                        ?? throw new InvalidOperationException("Unit not found.");
                    args.Data.RowVersion = existing.RowVersion;
                    args.Data.CurrentTenantId = existing.CurrentTenantId;
                    args.Data.IsFacility = existing.IsFacility;
                    await UnitService.UpdateAsync(args.Data);
                    break;
                case Syncfusion.Blazor.Grids.Action.Delete when args.Data is not null:
                    await UnitService.DeleteAsync(args.Data.Id);
                    break;
                default:
                    return;
            }

            await ReloadAsync();
            if (GridRef is not null)
            {
                await GridRef.Refresh();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UnitList operation failed.");
            ErrorMessage = ex.Message;
            await ReloadAsync();
            if (GridRef is not null)
            {
                await GridRef.Refresh();
            }
        }
    }

    private sealed record UnitStatusOption(UnitStatus Value, string Text);
}
