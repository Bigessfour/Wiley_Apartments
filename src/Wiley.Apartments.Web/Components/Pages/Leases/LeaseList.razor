@page "/leases"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@inject ILeaseService LeaseService
@inject NavigationManager Navigation
@inject IClerkToast Toast
@inject ILogger<LeaseList> Logger

<PageTitle>Leases</PageTitle>

<PageHeader Title="Leases" Subtitle="Brookside templates under DocumentRoot/templates">
    <SfButton CssClass="e-primary" Content="New lease" OnClick="@(() => Navigation.NavigateTo("/leases/new"))" />
</PageHeader>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}

<SfGrid @ref="GridRef"
        TValue="Lease"
        DataSource="@Leases"
        Toolbar="@ToolbarItems"
        AllowPaging="true"
        AllowSorting="true"
        AllowFiltering="true"
        Height="420">
    <GridEvents TValue="Lease"
                OnActionBegin="OnActionBegin"
                OnActionComplete="OnActionCompleteAsync"
                OnRecordDoubleClick="OnLeaseDoubleClick" />
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridTemplates>
        <EmptyRecordTemplate>
            <div class="grid-empty-hint">No leases yet — use New lease above.</div>
        </EmptyRecordTemplate>
    </GridTemplates>
    <GridEditSettings AllowAdding="false"
                      AllowEditing="false"
                      AllowDeleting="true"
                      Mode="EditMode.Normal"
                      ShowDeleteConfirmDialog="true" />
    <GridColumns>
        <GridColumn Field="@nameof(Lease.Id)" IsPrimaryKey="true" Visible="false" />
        <GridColumn HeaderText="Unit" Width="90">
            <Template>
                @{
                    var row = (Lease)context;
                }
                @(row.Unit?.Number ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Tenant" Width="180">
            <Template>
                @{
                    var row = (Lease)context;
                }
                @(row.Tenant is null ? "—" : $"{row.Tenant.LastName}, {row.Tenant.FirstName}")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Status" Width="130">
            <Template>
                @{
                    var row = (Lease)context;
                }
                <LeaseStatusChip Status="row.Status" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(Lease.TemplateUsed)" HeaderText="Template" Width="220" />
        <GridColumn Field="@nameof(Lease.Rent)" HeaderText="Rent" Width="100" Format="C2" />
        <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center" AllowEditing="false">
            <Template>
                @{
                    var row = (Lease)context;
                }
                <SfButton CssClass="e-small e-outline" Content="Open"
                          OnClick="@(() => Navigation.NavigateTo($"/leases/{row.Id}"))" />
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    private SfGrid<Lease>? GridRef;
    private List<Lease> Leases { get; set; } = [];
    private string? ErrorMessage { get; set; }

    private readonly List<string> ToolbarItems = ["Delete", "Search"];

    private void OnLeaseDoubleClick(RecordDoubleClickEventArgs<Lease> args)
    {
        if (args.RowData is Lease lease)
        {
            Navigation.NavigateTo($"/leases/{lease.Id}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LeaseList operation failed.");
            ErrorMessage = ex.Message;
        }
    }

    private async Task ReloadAsync()
    {
        Leases = (await LeaseService.GetAllAsync()).ToList();
    }

    private void OnActionBegin(ActionEventArgs<Lease> args)
    {
        if (args.RequestType != Syncfusion.Blazor.Grids.Action.Delete || args.Data is null)
        {
            return;
        }

        if (args.Data.Status is LeaseStatus.Active or LeaseStatus.Amended)
        {
            args.Cancel = true;
            ErrorMessage = "Active leases cannot be removed. Open the lease and use Terminate first.";
        }
    }

    private async Task OnActionCompleteAsync(ActionEventArgs<Lease> args)
    {
        try
        {
            if (args.RequestType != Syncfusion.Blazor.Grids.Action.Delete || args.Data is null)
            {
                return;
            }

            await LeaseService.SoftDeleteAsync(args.Data.Id);
            await Toast.ShowSuccessAsync("Lease removed.");
            await ReloadAsync();
            if (GridRef is not null)
            {
                await GridRef.Refresh();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LeaseList operation failed.");
            ErrorMessage = ex.Message;
            await ReloadAsync();
            if (GridRef is not null)
            {
                await GridRef.Refresh();
            }
        }
    }
}
