@page "/schedule"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Schedule
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@inject IScheduleService ScheduleService
@inject IUnitService UnitService
@inject IDateTimeService Clock
@inject IClerkToast Toast
@inject NavigationManager Navigation
@inject ILogger<OperationsCalendar> Logger

<PageTitle>Operations calendar</PageTitle>

<PageHeader Title="Operations calendar"
            Subtitle="@HeaderSubtitle">
    <SfButton CssClass="e-outline e-small" Content="Suggest turnover cleans" Disabled="@Busy"
              OnClick="SuggestTurnoverCleansAsync" />
    <SfButton CssClass="e-outline e-small" Content="Refresh" Disabled="@Busy" OnClick="ReloadAsync" />
</PageHeader>

@if (FilterUnitId is Guid)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 py-2" role="status">
        <span>Calendar filtered to <strong>@(FilterUnitLabel ?? "unit")</strong>.</span>
        <SfButton CssClass="e-small e-outline" Content="Clear unit filter" OnClick="ClearUnitFilterAsync" />
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}

<SfSchedule TValue="ScheduleAppointment"
            Width="100%"
            Height="700px"
            @bind-SelectedDate="SelectedDate"
            AllowDragAndDrop="true"
            AllowResizing="true"
            ShowQuickInfo="true">
    <ScheduleEvents TValue="ScheduleAppointment"
                    OnActionBegin="OnActionBegin"
                    ActionCompleted="OnActionCompleted"
                    EventRendered="OnEventRendered" />
    <ScheduleTemplates>
        <EditorTemplate>
            @{
                var appt = (ScheduleAppointment)context;
            }
            <table class="custom-event-editor w-100" cellpadding="5">
                <tbody>
                <tr>
                    <td class="e-textlabel">Title</td>
                    <td colspan="4">
                        <SfTextBox @bind-Value="appt.Subject" Placeholder="Title" />
                    </td>
                </tr>
                <tr>
                    <td class="e-textlabel">Category</td>
                    <td colspan="4">
                        <SfDropDownList TValue="string" TItem="CategoryOption"
                                        DataSource="@CategoryOptions"
                                        @bind-Value="appt.Category">
                            <DropDownListFieldSettings Text="Text" Value="Value" />
                        </SfDropDownList>
                    </td>
                </tr>
                <tr>
                    <td class="e-textlabel">Unit</td>
                    <td colspan="4">
                        <SfDropDownList TValue="Guid?" TItem="UnitOption"
                                        DataSource="@UnitOptions"
                                        Placeholder="Optional unit"
                                        AllowFiltering="true"
                                        ShowClearButton="true"
                                        @bind-Value="appt.UnitId">
                            <DropDownListFieldSettings Text="Text" Value="Id" />
                        </SfDropDownList>
                    </td>
                </tr>
                <tr>
                    <td class="e-textlabel">From</td>
                    <td colspan="4">
                        <SfDateTimePicker TValue="DateTime" @bind-Value="appt.StartTime" />
                    </td>
                </tr>
                <tr>
                    <td class="e-textlabel">To</td>
                    <td colspan="4">
                        <SfDateTimePicker TValue="DateTime?" @bind-Value="appt.EndTimeNullable" />
                    </td>
                </tr>
                <tr>
                    <td class="e-textlabel">Notes</td>
                    <td colspan="4">
                        <SfTextBox Multiline="true" @bind-Value="appt.Description" />
                    </td>
                </tr>
                </tbody>
            </table>
        </EditorTemplate>
    </ScheduleTemplates>
    <ScheduleEventSettings DataSource="@DataSource" />
    <ScheduleViews>
        <ScheduleView Option="View.Day" />
        <ScheduleView Option="View.Week" />
        <ScheduleView Option="View.Month" />
        <ScheduleView Option="View.Agenda" />
    </ScheduleViews>
</SfSchedule>

@code {
    [SupplyParameterFromQuery(Name = "unitId")]
    public Guid? QueryUnitId { get; set; }

    private DateTime SelectedDate { get; set; } = DateTime.Today;
    private List<ScheduleAppointment> DataSource { get; set; } = [];
    private List<UnitOption> UnitOptions { get; set; } = [];
    private string? ErrorMessage { get; set; }
    private bool Busy { get; set; }
    private bool _persisting;
    private Guid? FilterUnitId { get; set; }
    private string? FilterUnitLabel { get; set; }

    private string HeaderSubtitle =>
        FilterUnitId is Guid && !string.IsNullOrEmpty(FilterUnitLabel)
            ? $"Showing items for {FilterUnitLabel}. Cleaning, vacancy, inspection, and other unit work. Drag to reschedule."
            : "Cleaning, vacancy, inspection, and other unit work. Drag to reschedule. Upcoming reminders appear on the dashboard.";

    private static readonly List<CategoryOption> CategoryOptions =
    [
        new() { Value = nameof(ScheduledItemCategory.Cleaning), Text = "Cleaning" },
        new() { Value = nameof(ScheduledItemCategory.Vacancy), Text = "Vacancy" },
        new() { Value = nameof(ScheduledItemCategory.Inspection), Text = "Inspection" },
        new() { Value = nameof(ScheduledItemCategory.Other), Text = "Other" }
    ];

    protected override async Task OnInitializedAsync()
    {
        var units = await UnitService.GetAllAsync();
        UnitOptions = units
            .OrderBy(u => u.IsFacility ? 0 : 1)
            .ThenBy(u => u.Number)
            .Select(u => new UnitOption
            {
                Id = u.Id,
                Text = u.IsFacility ? $"Facility {u.Number}" : $"Unit {u.Number}"
            })
            .ToList();
        UnitOptions.Insert(0, new UnitOption { Id = null, Text = "(No unit)" });

        if (QueryUnitId is Guid uid)
        {
            FilterUnitId = uid;
            FilterUnitLabel = UnitOptions.FirstOrDefault(o => o.Id == uid)?.Text ?? "selected unit";
        }

        await ReloadAsync();
    }

    private async Task ClearUnitFilterAsync()
    {
        FilterUnitId = null;
        FilterUnitLabel = null;
        Navigation.NavigateTo("/schedule");
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            var items = await ScheduleService.QueryAsync(unitId: FilterUnitId, includeCompleted: true);
            var i = 1;
            DataSource = items.Select(s => ToAppointment(s, i++)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OperationsCalendar operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// T3.5.3 — for each Vacant unit without an open Cleaning item, schedule a turnover clean tomorrow 09:00–11:00 local.
    /// </summary>
    private async Task SuggestTurnoverCleansAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            var units = await UnitService.GetAllAsync();
            var vacant = units.Where(u => u.Status == UnitStatus.Vacant).ToList();
            var openCleans = await ScheduleService.QueryAsync(
                category: ScheduledItemCategory.Cleaning,
                includeCompleted: false);
            var covered = openCleans
                .Where(i => i.UnitId is not null)
                .Select(i => i.UnitId!.Value)
                .ToHashSet();

            var startLocal = DateTime.Today.AddDays(1).AddHours(9);
            var endLocal = startLocal.AddHours(2);
            var created = 0;
            foreach (var unit in vacant.Where(u => !covered.Contains(u.Id)))
            {
                await ScheduleService.CreateAsync(
                    $"Turnover clean — unit {unit.Number}",
                    ScheduledItemCategory.Cleaning,
                    Clock.ToUtc(startLocal),
                    endUtc: Clock.ToUtc(endLocal),
                    dueUtc: Clock.ToUtc(startLocal),
                    reminderOffset: TimeSpan.FromDays(1),
                    unitId: unit.Id,
                    notes: "Suggested after vacancy (turnover pattern).");
                created++;
            }

            await Toast.ShowSuccessAsync(created == 0
                ? "No new turnover cleans suggested (no uncovered vacant units)."
                : $"Created {created} turnover clean item(s) for vacant units.");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OperationsCalendar operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void OnActionBegin(Syncfusion.Blazor.Schedule.ActionEventArgs<ScheduleAppointment> args)
    {
        if (args.ActionType is Syncfusion.Blazor.Schedule.ActionType.EventCreate
            or Syncfusion.Blazor.Schedule.ActionType.EventChange)
        {
            var records = args.AddedRecords?.Concat(args.ChangedRecords ?? [])
                ?? args.ChangedRecords
                ?? [];
            foreach (var appt in records)
            {
                if (string.IsNullOrWhiteSpace(appt.Subject))
                {
                    args.Cancel = true;
                    ErrorMessage = "Title is required.";
                    return;
                }

                if (appt.EndTime < appt.StartTime)
                {
                    args.Cancel = true;
                    ErrorMessage = "End must be on or after start.";
                    return;
                }
            }
        }
    }

    private async Task OnActionCompleted(Syncfusion.Blazor.Schedule.ActionEventArgs<ScheduleAppointment> args)
    {
        if (_persisting)
        {
            return;
        }

        try
        {
            _persisting = true;
            ErrorMessage = null;

            if (args.ActionType == Syncfusion.Blazor.Schedule.ActionType.EventCreate
                && args.AddedRecords is { Count: > 0 })
            {
                foreach (var appt in args.AddedRecords)
                {
                    var unitId = NormalizeUnitId(appt.UnitId) ?? FilterUnitId;
                    await ScheduleService.CreateAsync(
                        appt.Subject,
                        ParseCategory(appt.Category),
                        Clock.ToUtc(appt.StartTime),
                        endUtc: Clock.ToUtc(ResolveEnd(appt)),
                        dueUtc: Clock.ToUtc(appt.StartTime),
                        unitId: unitId,
                        notes: appt.Description);
                }

                await ReloadAsync();
            }
            else if (args.ActionType == Syncfusion.Blazor.Schedule.ActionType.EventChange
                     && args.ChangedRecords is { Count: > 0 })
            {
                foreach (var appt in args.ChangedRecords)
                {
                    if (appt.ItemId == Guid.Empty)
                    {
                        continue;
                    }

                    await ScheduleService.UpdateAsync(
                        appt.ItemId,
                        appt.Subject,
                        ParseCategory(appt.Category),
                        Clock.ToUtc(appt.StartTime),
                        endUtc: Clock.ToUtc(ResolveEnd(appt)),
                        dueUtc: Clock.ToUtc(appt.StartTime),
                        unitId: NormalizeUnitId(appt.UnitId),
                        notes: appt.Description);
                }

                await ReloadAsync();
            }
            else if (args.ActionType == Syncfusion.Blazor.Schedule.ActionType.EventRemove
                     && args.DeletedRecords is { Count: > 0 })
            {
                foreach (var appt in args.DeletedRecords.Where(a => a.ItemId != Guid.Empty))
                {
                    await ScheduleService.SoftDeleteAsync(appt.ItemId);
                }

                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OperationsCalendar operation failed.");
            ErrorMessage = ex.Message;
            await ReloadAsync();
        }
        finally
        {
            _persisting = false;
        }
    }

    private void OnEventRendered(Syncfusion.Blazor.Schedule.EventRenderedArgs<ScheduleAppointment> args)
    {
        // Syncfusion may invoke EventRendered for placeholder/drag ghosts with null Data.
        // Never throw — LoggingErrorBoundary would otherwise spam on every vertical refresh.
        try
        {
            if (args?.Data is null)
            {
                return;
            }

            var css = ParseCategory(args.Data.Category) switch
            {
                ScheduledItemCategory.Cleaning => "cs-sched-cleaning",
                ScheduledItemCategory.Vacancy => "cs-sched-vacancy",
                ScheduledItemCategory.Inspection => "cs-sched-inspection",
                _ => "cs-sched-other"
            };

            if (args.CssClasses is null)
            {
                args.CssClasses = [css];
            }
            else if (!args.CssClasses.Contains(css))
            {
                args.CssClasses.Add(css);
            }
        }
        catch
        {
            // Styling only — ignore Syncfusion edge cases during render.
        }
    }

    private ScheduleAppointment ToAppointment(ScheduledItem item, int localId)
    {
        var start = Clock.ToDisplayTime(item.StartUtc);
        var end = item.EndUtc is DateTime e
            ? Clock.ToDisplayTime(e)
            : start.AddHours(1);
        var unitLabel = item.Unit is null ? null : $"Unit {item.Unit.Number}";
        return new ScheduleAppointment
        {
            Id = localId,
            ItemId = item.Id,
            Subject = item.Title,
            StartTime = start,
            EndTime = end,
            Description = item.Notes,
            Category = item.Category.ToString(),
            UnitId = item.UnitId,
            Location = unitLabel,
            IsAllDay = false
        };
    }

    private static DateTime ResolveEnd(ScheduleAppointment appt) =>
        appt.EndTimeNullable ?? appt.EndTime;

    private static Guid? NormalizeUnitId(Guid? unitId) =>
        unitId is Guid g && g != Guid.Empty ? g : null;

    private static ScheduledItemCategory ParseCategory(string? value) =>
        Enum.TryParse<ScheduledItemCategory>(value, ignoreCase: true, out var cat)
            ? cat
            : ScheduledItemCategory.Other;

    private sealed class ScheduleAppointment
    {
        public int Id { get; set; }
        public Guid ItemId { get; set; }
        public string Subject { get; set; } = string.Empty;
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
        public DateTime? EndTimeNullable
        {
            get => EndTime;
            set
            {
                if (value is DateTime dt)
                {
                    EndTime = dt;
                }
            }
        }
        public string? Description { get; set; }
        public string Category { get; set; } = nameof(ScheduledItemCategory.Other);
        public Guid? UnitId { get; set; }
        public string? Location { get; set; }
        public bool IsAllDay { get; set; }
    }

    private sealed class CategoryOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }

    private sealed class UnitOption
    {
        public Guid? Id { get; set; }
        public string Text { get; set; } = string.Empty;
    }
}
