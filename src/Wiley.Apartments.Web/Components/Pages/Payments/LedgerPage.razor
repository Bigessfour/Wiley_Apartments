@page "/payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@inject ILedgerService LedgerService
@inject ITenantService TenantService
@inject IUnitService UnitService
@inject IOccupancyService OccupancyService
@inject IDateTimeService Clock
@inject NavigationManager Navigation
@inject IClerkToast Toast

<PageTitle>Ledger</PageTitle>

<PageHeader Title="Tenant ledger"
            Subtitle="@HeaderSubtitle">
    <SfButton CssClass="e-primary e-small" Content="Record payment" Disabled="@Busy"
              OnClick="@(() => OpenFormAsync("payment"))" />
    <SfButton CssClass="e-outline e-small" Content="Post charge" Disabled="@Busy"
              OnClick="@(() => OpenFormAsync("charge"))" />
    <SfButton CssClass="e-outline e-small" Content="Generate rent charges" Disabled="@Busy"
              OnClick="GenerateRentChargesAsync" />
</PageHeader>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}

<div class="row g-3 mb-3" style="max-width: 960px;">
    <div class="col-md-5">
        <label class="form-label">Filter tenant</label>
        <SfDropDownList TValue="Guid?" TItem="IdOption"
                        DataSource="@TenantFilterOptions"
                        Placeholder="All tenants"
                        AllowFiltering="true"
                        ShowClearButton="true"
                        @bind-Value="FilterTenantId">
            <DropDownListFieldSettings Text="Text" Value="Id" />
        </SfDropDownList>
    </div>
    <div class="col-md-4">
        <label class="form-label">Filter unit</label>
        <SfDropDownList TValue="Guid?" TItem="IdOption"
                        DataSource="@UnitFilterOptions"
                        Placeholder="All units"
                        AllowFiltering="true"
                        ShowClearButton="true"
                        @bind-Value="FilterUnitId">
            <DropDownListFieldSettings Text="Text" Value="Id" />
        </SfDropDownList>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <SfButton CssClass="e-outline e-small" Content="Refresh list" Disabled="@Busy" OnClick="LoadAsync" />
    </div>
</div>

@if (ShowForm is "charge" or "payment")
{
    <div class="border rounded p-3 mb-4 ledger-entry-form" style="max-width: 720px;">
        <h2 class="h6 mb-3">@(ShowForm == "charge" ? "Post charge" : "Record payment")</h2>
        <p class="text-muted small mb-3">
            @(ShowForm == "payment"
                ? "Payment is applied to the tenant/unit running balance (charges − payments)."
                : "Charge increases the amount owed on the tenant/unit ledger.")
        </p>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label">Tenant <span class="text-danger">*</span></label>
                <SfDropDownList TValue="Guid?" TItem="IdOption"
                                DataSource="@TenantFormOptions"
                                AllowFiltering="true"
                                Placeholder="Select tenant"
                                @bind-Value="FormTenantId"
                                ValueChange="OnFormTenantChangedAsync">
                    <DropDownListFieldSettings Text="Text" Value="Id" />
                </SfDropDownList>
            </div>
            <div class="col-md-6">
                <label class="form-label">Unit <span class="text-danger">*</span></label>
                <SfDropDownList TValue="Guid?" TItem="IdOption"
                                DataSource="@UnitFormOptions"
                                AllowFiltering="true"
                                Placeholder="Select unit"
                                @bind-Value="FormUnitId">
                    <DropDownListFieldSettings Text="Text" Value="Id" />
                </SfDropDownList>
            </div>
            <div class="col-md-4">
                <label class="form-label">Amount <span class="text-danger">*</span></label>
                <SfNumericTextBox TValue="decimal?" @bind-Value="FormAmount" Format="C2" Min="0.01m" Placeholder="0.00" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Date <span class="text-danger">*</span></label>
                <SfDatePicker TValue="DateTime?" @bind-Value="FormDate" />
            </div>
            @if (ShowForm == "payment")
            {
                <div class="col-md-4">
                    <label class="form-label">Method <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="PaymentMethod" TItem="MethodOption"
                                    DataSource="@MethodOptions"
                                    @bind-Value="FormMethod">
                        <DropDownListFieldSettings Text="Text" Value="Value" />
                    </SfDropDownList>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Notes / reference</label>
                <SfTextBox @bind-Value="FormNotes" Placeholder="Check #, PayStar confirmation, memo…" />
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <SfButton CssClass="e-primary e-small"
                          Content="@(ShowForm == "payment" ? "Save payment" : "Save charge")"
                          Disabled="@Busy"
                          OnClick="SaveFormAsync" />
                <SfButton CssClass="e-flat e-small" Content="Cancel" OnClick="CloseForm" />
            </div>
        </div>
    </div>
}

<p class="small mb-2">
    <strong>Balance (current filter):</strong> @Balance.ToString("C")
    <span class="text-muted"> · Charge +, Payment −</span>
</p>

<SfGrid TValue="LedgerRow" DataSource="@Rows" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridPageSettings PageSize="25" />
    <GridTemplates>
        <EmptyRecordTemplate>
            <div class="grid-empty-hint">
                No ledger entries for this filter.
                Use <strong>Record payment</strong> or <strong>Post charge</strong> above.
            </div>
        </EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(LedgerRow.DateDisplay)" HeaderText="Date" Width="110" />
        <GridColumn Field="@nameof(LedgerRow.TenantName)" HeaderText="Tenant" Width="140" />
        <GridColumn Field="@nameof(LedgerRow.UnitNumber)" HeaderText="Unit" Width="80" />
        <GridColumn Field="@nameof(LedgerRow.EntryType)" HeaderText="Type" Width="100" />
        <GridColumn Field="@nameof(LedgerRow.Amount)" HeaderText="Amount" Format="C2" Width="110" TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(LedgerRow.RunningBalance)" HeaderText="Balance" Format="C2" Width="110" TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(LedgerRow.Method)" HeaderText="Method" Width="120" />
        <GridColumn Field="@nameof(LedgerRow.Notes)" HeaderText="Notes" />
    </GridColumns>
</SfGrid>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public Guid? QueryTenantId { get; set; }

    [SupplyParameterFromQuery(Name = "unitId")]
    public Guid? QueryUnitId { get; set; }

    [SupplyParameterFromQuery(Name = "action")]
    public string? QueryAction { get; set; }

    private List<LedgerRow> Rows { get; set; } = [];
    private List<IdOption> TenantFilterOptions { get; set; } = [];
    private List<IdOption> UnitFilterOptions { get; set; } = [];
    private List<IdOption> TenantFormOptions { get; set; } = [];
    private List<IdOption> UnitFormOptions { get; set; } = [];
    private Guid? FilterTenantId { get; set; }
    private Guid? FilterUnitId { get; set; }
    private decimal Balance { get; set; }
    private string? ErrorMessage { get; set; }
    private bool Busy { get; set; }
    private string? ShowForm { get; set; }
    private Guid? FormTenantId { get; set; }
    private Guid? FormUnitId { get; set; }
    private decimal? FormAmount { get; set; }
    private DateTime? FormDate { get; set; } = DateTime.Today;
    private PaymentMethod FormMethod { get; set; } = PaymentMethod.Cash;
    private string? FormNotes { get; set; }
    private bool _queryApplied;
    private string? FilterUnitLabel { get; set; }

    private string HeaderSubtitle =>
        FilterUnitId is Guid && !string.IsNullOrEmpty(FilterUnitLabel)
            ? $"Ledger filtered to {FilterUnitLabel}. Record charges and payments; balance updates immediately."
            : "Record charges and payments (cash, check, online reference). Payments reduce the running balance immediately.";

    private static readonly List<MethodOption> MethodOptions =
    [
        new() { Value = PaymentMethod.Cash, Text = "Cash" },
        new() { Value = PaymentMethod.Check, Text = "Check" },
        new() { Value = PaymentMethod.OnlineReference, Text = "Online reference" },
        new() { Value = PaymentMethod.Other, Text = "Other" }
    ];

    protected override async Task OnInitializedAsync()
    {
        var tenants = await TenantService.SearchAsync();
        TenantFormOptions = tenants
            .OrderBy(t => t.LastName)
            .Select(t => new IdOption { Id = t.Id, Text = $"{t.LastName}, {t.FirstName}" })
            .ToList();
        TenantFilterOptions =
        [
            new IdOption { Id = null, Text = "(All tenants)" },
            .. TenantFormOptions
        ];

        var units = await UnitService.GetAllAsync();
        UnitFormOptions = units
            .OrderBy(u => u.IsFacility ? 0 : 1)
            .ThenBy(u => u.Number)
            .Select(u => new IdOption
            {
                Id = u.Id,
                Text = u.IsFacility ? $"Facility {u.Number}" : $"Unit {u.Number}"
            })
            .ToList();
        UnitFilterOptions =
        [
            new IdOption { Id = null, Text = "(All units)" },
            .. UnitFormOptions
        ];

        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_queryApplied)
        {
            return;
        }

        if (QueryTenantId is Guid tid)
        {
            FilterTenantId = tid;
            FormTenantId = tid;
        }

        if (QueryUnitId is Guid uid)
        {
            FilterUnitId = uid;
            FormUnitId = uid;
            FilterUnitLabel = UnitFilterOptions.FirstOrDefault(o => o.Id == uid)?.Text
                ?? UnitFormOptions.FirstOrDefault(o => o.Id == uid)?.Text
                ?? "selected unit";
        }

        var action = QueryAction?.Trim().ToLowerInvariant();
        if (action is "payment" or "charge")
        {
            _queryApplied = true;
            await OpenFormAsync(action);
            if (FilterTenantId is not null || FilterUnitId is not null)
            {
                await LoadAsync();
            }
        }
        else if (QueryTenantId is not null || QueryUnitId is not null)
        {
            _queryApplied = true;
            await LoadAsync();
        }
    }

    private async Task OpenFormAsync(string form)
    {
        ShowForm = form;
        ErrorMessage = null;
        FormDate ??= DateTime.Today;
        FormTenantId ??= FilterTenantId;
        FormUnitId ??= FilterUnitId;
        if (FormTenantId is Guid tenantId && FormUnitId is null)
        {
            await SuggestUnitForTenantAsync(tenantId);
        }
    }

    private void CloseForm()
    {
        ShowForm = null;
        ErrorMessage = null;
    }

    private async Task OnFormTenantChangedAsync(ChangeEventArgs<Guid?, IdOption> args)
    {
        FormTenantId = args.Value;
        if (FormTenantId is Guid tenantId)
        {
            await SuggestUnitForTenantAsync(tenantId);
        }
    }

    private async Task SuggestUnitForTenantAsync(Guid tenantId)
    {
        var history = await OccupancyService.GetHistoryForTenantAsync(tenantId);
        var current = history.FirstOrDefault(o => o.EndUtc is null);
        if (current is not null)
        {
            FormUnitId = current.UnitId;
        }
    }

    private async Task LoadAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            var lines = await LedgerService.GetLedgerAsync(FilterTenantId, FilterUnitId);
            Rows = lines.Select(l => new LedgerRow
            {
                DateDisplay = Clock.ToDisplayTime(l.Entry.DateUtc).ToString("d"),
                TenantName = l.Entry.Tenant is null
                    ? ""
                    : $"{l.Entry.Tenant.LastName}, {l.Entry.Tenant.FirstName}",
                UnitNumber = l.Entry.Unit?.Number ?? "",
                EntryType = l.Entry.EntryType.ToString(),
                Amount = l.Entry.Amount,
                RunningBalance = l.RunningBalance,
                Method = l.Entry.Method?.ToString() ?? "",
                Notes = l.Entry.Notes ?? ""
            }).ToList();
            Balance = lines.Count == 0 ? 0m : lines[^1].RunningBalance;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SaveFormAsync()
    {
        if (FormTenantId is null || FormUnitId is null || FormAmount is null || FormDate is null)
        {
            ErrorMessage = "Tenant, unit, amount, and date are required.";
            return;
        }

        if (FormAmount <= 0)
        {
            ErrorMessage = "Amount must be greater than zero.";
            return;
        }

        Busy = true;
        ErrorMessage = null;
        try
        {
            var dateUtc = Clock.ToUtc(FormDate.Value.Date);
            if (ShowForm == "charge")
            {
                await LedgerService.PostChargeAsync(
                    FormTenantId.Value,
                    FormUnitId.Value,
                    FormAmount.Value,
                    dateUtc,
                    notes: FormNotes);
                await Toast.ShowSuccessAsync("Charge posted.");
            }
            else
            {
                await LedgerService.PostPaymentAsync(
                    FormTenantId.Value,
                    FormUnitId.Value,
                    FormAmount.Value,
                    dateUtc,
                    FormMethod,
                    notes: FormNotes);
                await Toast.ShowSuccessAsync($"Payment recorded ({FormMethod}). Balance updated.");
            }

            FilterTenantId = FormTenantId;
            FilterUnitId = FormUnitId;
            ShowForm = null;
            FormAmount = null;
            FormNotes = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task GenerateRentChargesAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            var count = await LedgerService.PostMonthlyRentChargesAsync();
            await Toast.ShowSuccessAsync(count == 0
                ? "No new rent charges needed for this month."
                : $"Posted {count} rent charge(s) for active leases.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private sealed class LedgerRow
    {
        public string DateDisplay { get; set; } = "";
        public string TenantName { get; set; } = "";
        public string UnitNumber { get; set; } = "";
        public string EntryType { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal RunningBalance { get; set; }
        public string Method { get; set; } = "";
        public string Notes { get; set; } = "";
    }

    private sealed class IdOption
    {
        public Guid? Id { get; set; }
        public string Text { get; set; } = "";
    }

    private sealed class MethodOption
    {
        public PaymentMethod Value { get; set; }
        public string Text { get; set; } = "";
    }
}
