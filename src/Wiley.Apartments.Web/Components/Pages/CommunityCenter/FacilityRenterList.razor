@page "/community-center/renters"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Wiley.Apartments.Domain
@using Wiley.Apartments.Web.Components.Shared

<PageTitle>CC Renters</PageTitle>

<PageHeader Title="Community Center renters"
            Subtitle="Event / hall hirers — separate from residential tenants.">
    <SfButton CssClass="e-outline e-small" Content="CC hub"
              OnClick="@(() => Navigation.NavigateTo("/community-center"))" />
</PageHeader>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}

<SfGrid @ref="GridRef"
        TValue="FacilityRenter"
        DataSource="@Rows"
        Toolbar="@(new List<string> { "Add", "Edit", "Delete", "Update", "Cancel", "Search" })"
        AllowPaging="true"
        AllowSorting="true"
        AllowFiltering="true"
        Height="420">
    <GridEvents TValue="FacilityRenter"
                OnActionBegin="OnActionBeginAsync"
                OnActionComplete="OnActionCompleteAsync"
                OnRecordDoubleClick="OnDoubleClick" />
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true"
                      Mode="EditMode.Dialog" ShowDeleteConfirmDialog="true" />
    <GridTemplates>
        <EmptyRecordTemplate>
            <div class="grid-empty-hint">No Community Center renters yet — use Add, or load demo data from Settings.</div>
        </EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(FacilityRenter.Id)" IsPrimaryKey="true" Visible="false" />
        <GridColumn Field="@nameof(FacilityRenter.LastName)" HeaderText="Last" Width="120"
                    ValidationRules="@(new ValidationRules { Required = true })" />
        <GridColumn Field="@nameof(FacilityRenter.FirstName)" HeaderText="First" Width="120"
                    ValidationRules="@(new ValidationRules { Required = true })" />
        <GridColumn Field="@nameof(FacilityRenter.Organization)" HeaderText="Organization" Width="140" />
        <GridColumn Field="@nameof(FacilityRenter.Phone)" HeaderText="Phone" Width="140"
                    ValidationRules="@(new ValidationRules { Required = true })">
            <EditTemplate>
                @{
                    var renter = (FacilityRenter)context;
                }
                <SfMaskedTextBox @bind-Value="renter.Phone"
                                 Mask="(000) 000-0000"
                                 PromptChar="@('_')"
                                 Placeholder="(719) 555-0100"
                                 Width="100%" />
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(FacilityRenter.Email)" HeaderText="Email" Width="180"
                    ValidationRules="@(new ValidationRules { Required = true })" />
        <GridColumn Field="@nameof(FacilityRenter.MailingAddress)" HeaderText="Address" Width="200"
                    ValidationRules="@(new ValidationRules { Required = true })" />
        <GridColumn Field="@nameof(FacilityRenter.AlternateContact)" HeaderText="Day-of / emergency contact" Width="180" />
        <GridColumn Field="@nameof(FacilityRenter.IdType)" HeaderText="Photo ID type" Width="150">
            <EditTemplate>
                @{
                    var renter = (FacilityRenter)context;
                }
                <SfDropDownList TValue="string"
                                TItem="IdTypeOption"
                                DataSource="@IdTypeOptions"
                                @bind-Value="renter.IdType"
                                Placeholder="Select the ID they present"
                                AllowFiltering="true"
                                AllowCustom="true"
                                PopupHeight="240px"
                                Width="100%">
                    <DropDownListFieldSettings Value="Value" Text="Text" />
                </SfDropDownList>
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(FacilityRenter.IdReference)"
                    HeaderText="ID last 4 or document #"
                    Width="180">
            <EditTemplate>
                @{
                    var renter = (FacilityRenter)context;
                }
                <SfTextBox @bind-Value="renter.IdReference"
                           Placeholder="Last 4 of DL/ID, or passport number — not a full SSN"
                           Width="100%" />
            </EditTemplate>
        </GridColumn>
        <GridColumn Field="@nameof(FacilityRenter.Notes)" HeaderText="Notes" Width="160" />
        <GridColumn Field="@nameof(FacilityRenter.RowVersion)" Visible="false" />
    </GridColumns>
</SfGrid>
