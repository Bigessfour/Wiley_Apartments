@page "/community-center/renters/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@using Wiley.Apartments.Web.Components.Shared
@inject IFacilityRenterService RenterService
@inject IFacilityReservationService ReservationService
@inject IDateTimeService Clock
@inject NavigationManager Navigation
@inject ILogger<FacilityRenterDetail> Logger

<PageTitle>CC Renter</PageTitle>

@if (!string.IsNullOrEmpty(LoadError))
{
    <div class="alert alert-warning">@LoadError</div>
}

@if (Renter is null && string.IsNullOrEmpty(LoadError))
{
    <PageHeader Title="Renter" Subtitle="Loading…" />
}
else if (Renter is null)
{
    <PageHeader Title="Renter" Subtitle="Not found">
        <SfButton CssClass="e-outline e-small" Content="All renters"
                  OnClick="@(() => Navigation.NavigateTo("/community-center/renters"))" />
    </PageHeader>
}
else
{
    <PageHeader Title="@($"{Renter.LastName}, {Renter.FirstName}")"
                Subtitle="@(Renter.Organization ?? "Community Center renter")">
        <SfButton CssClass="e-outline e-small" Content="All renters"
                  OnClick="@(() => Navigation.NavigateTo("/community-center/renters"))" />
        <SfButton CssClass="e-primary e-small" Content="New reservation"
                  OnClick="@(() => Navigation.NavigateTo($"/community-center/reservations?renterId={Renter.Id}"))" />
    </PageHeader>

    <div class="mb-3">
        <p class="mb-1"><strong>Phone</strong> @Renter.Phone</p>
        <p class="mb-1"><strong>Email</strong> @Renter.Email</p>
        <p class="mb-1"><strong>Address</strong> @Renter.MailingAddress</p>
        <p class="mb-1"><strong>Alternate</strong> @(Renter.AlternateContact ?? "—")</p>
        <p class="mb-1"><strong>ID</strong> @(Renter.IdType ?? "—") @(Renter.IdReference)</p>
        <p class="mb-0"><strong>Notes</strong> @(string.IsNullOrWhiteSpace(Renter.Notes) ? "—" : Renter.Notes)</p>
    </div>

    <h2 class="h6">Reservations</h2>
    @if (Reservations.Count == 0)
    {
        <p class="text-muted">No reservations yet — use New reservation to book the hall.</p>
    }
    else
    {
        <ul class="list-unstyled mb-0">
            @foreach (var r in Reservations)
            {
                <li class="mb-1">
                    <a href="@($"/community-center/reservations/{r.Id}")">
                        @Clock.ToDisplayTime(r.StartUtc).ToString("g") → @Clock.ToDisplayTime(r.EndUtc).ToString("g")
                        · @r.Status · @r.RentalFee.ToString("C")
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private FacilityRenter? Renter { get; set; }
    private List<FacilityReservation> Reservations { get; set; } = [];
    private string? LoadError { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        LoadError = null;
        try
        {
            Renter = await RenterService.GetByIdAsync(Id);
            if (Renter is null || Renter.IsDeleted)
            {
                Logger.LogWarning("FacilityRenterDetail: renter {RenterId} not found or deleted.", Id);
                Renter = null;
                LoadError = "Renter not found.";
                return;
            }

            Reservations = [.. await ReservationService.ListAsync(facilityRenterId: Id)];
            Logger.LogInformation(
                "FacilityRenterDetail loaded renter {RenterId} name={LastName},{FirstName} reservations={Count}.",
                Id, Renter.LastName, Renter.FirstName, Reservations.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FacilityRenterDetail load failed for {RenterId}.", Id);
            Renter = null;
            LoadError = ex.Message;
        }
    }
}
