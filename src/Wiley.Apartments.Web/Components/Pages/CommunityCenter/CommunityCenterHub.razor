@page "/community-center"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@inject IUnitService UnitService
@inject NavigationManager Navigation
@inject ILogger<CommunityCenterHub> Logger

<PageTitle>Community Center</PageTitle>

@if (LoadError is not null)
{
    <div class="alert alert-warning">@LoadError</div>
}
else if (!_loaded)
{
    <PageHeader Title="Community Center" Subtitle="Loading…" />
}
else if (Facility is null)
{
    <PageHeader Title="Community Center"
                Subtitle="Facility unit not found yet. Restart the app so the seeder can create Number=CC (IsFacility)." />
}
else
{
    <PageHeader Title="Community Center"
                Subtitle="Facility rentals, inventory, inspections, and maintenance — data lives on CC tabs. Calendar is shared with apartments.">
        <SfButton CssClass="e-outline e-small" Content="Open unit record"
                  OnClick="@(() => Navigation.NavigateTo($"/units/{Facility.Id}"))" />
    </PageHeader>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <SfCard CssClass="h-100">
                <CardHeader Title="Facility unit" />
                <CardContent>
                    <p class="mb-1"><strong>Number</strong> @Facility.Number</p>
                    <p class="mb-1"><strong>Status</strong> @Facility.Status</p>
                    <p class="mb-0 text-muted small">@(string.IsNullOrWhiteSpace(Facility.Notes) ? "No notes." : Facility.Notes)</p>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-md-6 col-xl-3">
            <SfCard CssClass="h-100">
                <CardHeader Title="Layout" />
                <CardContent>
                    <p class="mb-1">@Facility.SqFt.ToString("N0") sq ft</p>
                    <p class="mb-0">Hall / kitchen facility</p>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-md-12 col-xl-6">
            <SfCard CssClass="h-100">
                <CardHeader Title="Clerk workflow" />
                <CardContent>
                    <ul class="mb-0 small">
                        <li>Renters → reservation (confirm) → agreement PDF → deposit/fee + receipt.</li>
                        <li>Shared schedule shows confirmed rentals and CC maintenance.</li>
                        <li>Post-rental inspection before completing; inventory for chairs/kitchen/etc.</li>
                    </ul>
                </CardContent>
            </SfCard>
        </div>
    </div>

    <h2 class="h6 mb-2">Community Center tabs</h2>
    <div class="d-flex flex-wrap gap-2">
        <SfButton CssClass="e-primary" Content="Renters"
                  OnClick="@(() => Navigation.NavigateTo("/community-center/renters"))" />
        <SfButton CssClass="e-primary" Content="Reservations"
                  OnClick="@(() => Navigation.NavigateTo("/community-center/reservations"))" />
        <SfButton CssClass="e-outline" Content="Schedule"
                  OnClick="@(() => Navigation.NavigateTo($"/schedule?unitId={Facility.Id}"))" />
        <SfButton CssClass="e-outline" Content="Payments"
                  OnClick="@(() => Navigation.NavigateTo($"/payments?unitId={Facility.Id}"))" />
        <SfButton CssClass="e-outline" Content="Inspections"
                  OnClick="@(() => Navigation.NavigateTo("/community-center/inspections"))" />
        <SfButton CssClass="e-outline" Content="Inventory"
                  OnClick="@(() => Navigation.NavigateTo("/community-center/inventory"))" />
        <SfButton CssClass="e-outline" Content="Maintenance"
                  OnClick="@(() => Navigation.NavigateTo($"/maintenance?unitId={Facility.Id}"))" />
        <SfButton CssClass="e-outline" Content="Documents"
                  OnClick="@(() => Navigation.NavigateTo("/documents?cc=1"))" />
    </div>
    <p class="small text-muted mt-2 mb-0">
        Documents opens the vault filtered to Community Center records (`?cc=1`). Pick CC renter / reservation / inspection / inventory when uploading.
    </p>
}

@code {
    private Unit? Facility { get; set; }
    private string? LoadError { get; set; }
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Facility = await UnitService.GetFacilityAsync();
            if (Facility is null)
            {
                Logger.LogWarning("CommunityCenterHub: facility unit CC not found (seeder may not have run).");
            }
            else
            {
                Logger.LogInformation(
                    "CommunityCenterHub loaded facility unit {UnitId} number={Number} status={Status}.",
                    Facility.Id, Facility.Number, Facility.Status);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CommunityCenterHub load failed.");
            LoadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }
}
