@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Chart3D
@using Syncfusion.Blazor.CircularGauge
@using Syncfusion.Blazor.HeatMap
@using Syncfusion.Blazor.Layouts
@using Syncfusion.Blazor.LinearGauge
@using Syncfusion.Blazor.Navigations
@using Wiley.Apartments.Contracts
@inject IDashboardService DashboardService
@inject IPortfolioProfitLossService ProfitLoss
@inject IDateTimeService Clock
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>ClerkSuite Dashboard</PageTitle>

<PageHeader Title="ClerkSuite dashboard"
            Subtitle="@($"Occupancy, collection, expirations, work orders · Mountain Time {DisplayTime}")">
    <SfButton CssClass="e-outline" Content="Refresh" OnClick="LoadAsync" />
    <SfButton CssClass="e-outline" Content="Export charts" OnClick="ExportChartsAsync" Disabled="@(Snap is null)" />
    <SfButton CssClass="e-outline" Content="Reset layout" OnClick="ResetLayoutAsync" />
</PageHeader>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}
else if (Snap is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="kpi-grid kpi-grid--viz">
        <SfCard CssClass="kpi-card kpi-card--accent kpi-card--gauge">
            <CardContent>
                <div class="kpi-label">Occupancy</div>
                <div class="kpi-gauge-wrap">
                    <SfCircularGauge Height="120px" Width="100%" Theme="@ChartTheme">
                        <CircularGaugeAxes>
                            <CircularGaugeAxis StartAngle="210" EndAngle="150" Minimum="0" Maximum="100">
                                <CircularGaugeAxisMajorTicks Height="0" />
                                <CircularGaugeAxisMinorTicks Height="0" />
                                <CircularGaugeAxisLabelStyle Format=" " />
                                <CircularGaugeRanges>
                                    <CircularGaugeRange Start="0" End="100" Color="#c5d8f0" StartWidth="12" EndWidth="12" Radius="90%" />
                                </CircularGaugeRanges>
                                <CircularGaugePointers>
                                    <CircularGaugePointer Value="@Snap.OccupancyPercent"
                                                          Type="PointerType.RangeBar"
                                                          PointerWidth="12"
                                                          Color="#0f6cbd"
                                                          Radius="90%"
                                                          RoundedCornerRadius="6" />
                                </CircularGaugePointers>
                                <CircularGaugeAnnotations>
                                    <CircularGaugeAnnotation Content="@($"{Snap.OccupancyPercent:0.#}%")" Angle="180" Radius="0%" ZIndex="1">
                                        <CircularGaugeAnnotationTextStyle Size="18px" FontWeight="600" />
                                    </CircularGaugeAnnotation>
                                </CircularGaugeAnnotations>
                            </CircularGaugeAxis>
                        </CircularGaugeAxes>
                    </SfCircularGauge>
                </div>
                <div class="kpi-sub"><a href="units">@Snap.Occupied / @Snap.TotalUnits occupied</a></div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Collected this month</div>
                <div class="kpi-value">@Snap.CollectedThisMonth.ToString("C0")</div>
                <div class="kpi-sub">Expected @Snap.ExpectedRentThisMonth.ToString("C0") · @CollectionRateLabel</div>
                <div class="kpi-linear-gauge">
                    <SfLinearGauge Height="56px" Width="100%" Theme="@ChartTheme">
                        <LinearGaugeAxes>
                            <LinearGaugeAxis Minimum="0" Maximum="@(Math.Max(100, Snap.CollectionRatePercent))">
                                <LinearGaugeAxisLabelStyle Format="{value}%" />
                                <LinearGaugePointers>
                                    <LinearGaugePointer PointerValue="@Snap.CollectionRatePercent"
                                                        Type="Syncfusion.Blazor.LinearGauge.Point.Bar"
                                                        Color="#0f6cbd"
                                                        Width="12" />
                                </LinearGaugePointers>
                            </LinearGaugeAxis>
                        </LinearGaugeAxes>
                    </SfLinearGauge>
                </div>
                @if (CollectionSparkData.Count > 0)
                {
                    <div class="kpi-spark">
                        <SfSparkline TValue="SparkPoint"
                                     DataSource="@CollectionSparkData"
                                     XName="Label"
                                     YName="Amount"
                                     Type="SparklineType.Area"
                                     Height="28px"
                                     Width="100%"
                                     Fill="#0f6cbd"
                                     LineWidth="1.5"
                                     Theme="@ChartTheme">
                        </SfSparkline>
                    </div>
                }
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card kpi-card--danger">
            <CardContent>
                <div class="kpi-label">Outstanding</div>
                <div class="kpi-value"><a href="reports/delinquency">@Snap.OutstandingBalanceTotal.ToString("C0")</a></div>
                <div class="kpi-sub">@Snap.Delinquencies.Count delinquent account(s)</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card kpi-card--warn">
            <CardContent>
                <div class="kpi-label">Open work orders</div>
                <div class="kpi-value"><a href="maintenance">@Snap.OpenWorkOrders.Count</a></div>
                <div class="kpi-sub">Maintenance queue</div>
            </CardContent>
        </SfCard>
    </div>

    <SfDashboardLayout @ref="_layout"
                       ID="clerksuite-home-dashboard"
                       Columns="6"
                       CellSpacing="@(new double[] { 14, 14 })"
                       AllowResizing="true"
                       AllowDragging="true"
                       EnablePersistence="true"
                       MediaQuery="max-width: 768px">
        <DashboardLayoutPanels>
            <DashboardLayoutPanel Id="statusDonut" SizeX="3" SizeY="3" Row="0" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-title">Units by status</div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px;">
                        <SfAccumulationChart Width="100%" Height="100%" Theme="@ChartTheme" EnableSmartLabels="true">
                            <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom" />
                            <AccumulationChartTooltipSettings Enable="true" Format="${point.x}: <b>${point.y}</b>" />
                            <AccumulationChartSeriesCollection>
                                <AccumulationChartSeries DataSource="@StatusSlices"
                                                         XName="Status"
                                                         YName="Count"
                                                         Name="Units"
                                                         InnerRadius="55%"
                                                         Radius="80%"
                                                         Type="AccumulationType.Pie">
                                    <AccumulationDataLabelSettings Visible="true" Name="Status" />
                                </AccumulationChartSeries>
                            </AccumulationChartSeriesCollection>
                        </SfAccumulationChart>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="collectionTrend" SizeX="3" SizeY="3" Row="0" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-title d-flex justify-content-between align-items-center w-100">
                        <span>Rent collected (12 months)</span>
                        <span class="small text-muted">zoom / pan</span>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px;">
                        @if (CollectionChart.Count == 0 || CollectionChart.All(c => c.Amount == 0))
                        {
                            <p class="text-muted small p-2 mb-0">No non-deposit payments in the last 12 months.</p>
                        }
                        else
                        {
                            <SfChart @ref="_collectionChart" Width="100%" Height="100%" Theme="@ChartTheme">
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" LabelRotation="-45" />
                                <ChartPrimaryYAxis LabelFormat="C0" />
                                <ChartTooltipSettings Enable="true" />
                                <ChartZoomSettings EnableSelectionZooming="true"
                                                   EnableMouseWheelZooming="true"
                                                   EnablePinchZooming="true"
                                                   Mode="Syncfusion.Blazor.Charts.ZoomMode.X"
                                                   EnableScrollbar="true" />
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@CollectionChart"
                                                 XName="Label"
                                                 YName="Amount"
                                                 Type="ChartSeriesType.Column"
                                                 Name="Collected"
                                                 Fill="#0f6cbd" />
                                </ChartSeriesCollection>
                            </SfChart>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="payHeat" SizeX="6" SizeY="3" Row="3" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-title">Payments by unit × month (heatmap)</div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px; overflow:auto;">
                        @if (HeatCells.Count == 0)
                        {
                            <p class="text-muted small p-2 mb-0">No payment heatmap data yet.</p>
                        }
                        else
                        {
                            @* JSON cell binding per Syncfusion HeatMap docs:
                               https://blazor.syncfusion.com/documentation/heatmap-chart/working-with-data *@
                            <SfHeatMap DataSource="@HeatCells"
                                       Height="100%"
                                       Width="100%"
                                       Theme="@ChartTheme">
                                <HeatMapTitleSettings Text="Rent payments ($)" />
                                <HeatMapDataSourceSettings IsJsonData="true"
                                                           AdaptorType="AdaptorType.Cell"
                                                           XDataMapping="Unit"
                                                           YDataMapping="Month"
                                                           ValueMapping="Value" />
                                <HeatMapXAxis Labels="@HeatUnitLabels" LabelRotation="45" />
                                <HeatMapYAxis Labels="@HeatMonthLabels" />
                                <HeatMapCellSettings ShowLabel="false" Format="C0" />
                                <HeatMapTooltipSettings Enable="true" />
                                <HeatMapLegendSettings Visible="true" Position="Syncfusion.Blazor.HeatMap.LegendPosition.Bottom" />
                                <HeatMapPaletteSettings Type="PaletteType.Gradient">
                                    <HeatMapPalettes>
                                        <HeatMapPalette Value="0" Color="#f3f6f9" />
                                        <HeatMapPalette Color="#9dc3eb" />
                                        <HeatMapPalette Color="#0f6cbd" />
                                    </HeatMapPalettes>
                                </HeatMapPaletteSettings>
                            </SfHeatMap>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="exp30" SizeX="3" SizeY="2" Row="6" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Leases expiring (≤30 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ExpiringLeasesWithin30.Count</span>
                            <a class="panel-view-all" href="leases">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ExpiringLeasesWithin30.Count == 0)
                        {
                            <p class="text-muted small mb-0">None in window.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var l in Snap.ExpiringLeasesWithin30)
                                {
                                    <li class="mb-1">
                                        <a href="@($"/leases/{l.LeaseId}")">Unit @l.UnitNumber</a>
                                        — @l.TenantName · @Clock.ToDisplayTime(l.EndUtc).ToString("d")
                                        (@l.DaysRemaining d)
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="exp60" SizeX="3" SizeY="2" Row="6" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Leases expiring (31–60 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ExpiringLeasesWithin60.Count</span>
                            <a class="panel-view-all" href="leases">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ExpiringLeasesWithin60.Count == 0)
                        {
                            <p class="text-muted small mb-0">None in window.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var l in Snap.ExpiringLeasesWithin60)
                                {
                                    <li class="mb-1">
                                        <a href="@($"/leases/{l.LeaseId}")">Unit @l.UnitNumber</a>
                                        — @l.TenantName · @Clock.ToDisplayTime(l.EndUtc).ToString("d")
                                        (@l.DaysRemaining d)
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="schedule" SizeX="3" SizeY="2" Row="8" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Schedule reminders (14 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ScheduleReminders.Count</span>
                            <a class="panel-view-all" href="schedule">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ScheduleReminders.Count == 0)
                        {
                            <p class="text-muted small mb-0">No upcoming reminders.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var s in Snap.ScheduleReminders)
                                {
                                    <li class="mb-1">
                                        <a href="schedule">Unit @s.UnitNumber</a>
                                        — @s.Title · @Clock.ToDisplayTime(s.ReminderUtc).ToString("d")
                                        (@s.Category)
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="wo" SizeX="3" SizeY="2" Row="8" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Open maintenance</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.OpenWorkOrders.Count</span>
                            <a class="panel-view-all" href="maintenance">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.OpenWorkOrders.Count == 0)
                        {
                            <p class="text-muted small mb-0">No open work orders.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var m in Snap.OpenWorkOrders)
                                {
                                    <li class="mb-1">
                                        <a href="maintenance">Unit @m.UnitNumber</a>
                                        · @m.Priority · @m.Description
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="delinq" SizeX="3" SizeY="2" Row="10" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Delinquencies</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.Delinquencies.Count</span>
                            <a class="panel-view-all" href="reports/delinquency">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.Delinquencies.Count == 0)
                        {
                            <p class="text-muted small mb-0">None.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var d in Snap.Delinquencies)
                                {
                                    <li class="mb-1">
                                        <a href="reports/delinquency">Unit @d.UnitNumber</a>
                                        — @d.TenantName · @d.Balance.ToString("C")
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="warranty" SizeX="3" SizeY="2" Row="10" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Warranties (90 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ExpiringWarranties.Count</span>
                            <a class="panel-view-all" href="reports/warranty">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ExpiringWarranties.Count == 0)
                        {
                            <p class="text-muted small mb-0">None expiring soon.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var w in Snap.ExpiringWarranties)
                                {
                                    <li class="mb-1">
                                        <a href="@($"/units/{w.UnitId}")">Unit @w.UnitNumber</a>
                                        — @w.AssetLabel · @w.WarrantyEnd.ToString("d")
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="plUnit" SizeX="3" SizeY="3" Row="12" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-title d-flex justify-content-between align-items-center w-100">
                        <span>P/L by unit (YTD, 3D)</span>
                        <a class="small" href="reports/profit-loss">Full report</a>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px;">
                        @if (UnitChart.Count == 0)
                        {
                            <p class="text-muted small p-2 mb-0">No ledger/ops-cost data yet.</p>
                        }
                        else
                        {
                            @* 3D column chart per Syncfusion Chart3D docs:
                               RotationAngle/Depth/EnableRotation — not Tilt/Rotation *@
                            <SfChart3D Width="100%"
                                       Height="100%"
                                       Theme="@ChartTheme"
                                       EnableRotation="true"
                                       RotationAngle="22"
                                       Depth="100"
                                       TiltAngle="10">
                                <Chart3DPrimaryXAxis ValueType="Syncfusion.Blazor.Chart3D.ValueType.Category"
                                                     LabelRotationAngle="-45"
                                                     LabelIntersectAction="Syncfusion.Blazor.Chart3D.LabelIntersectAction.Rotate45" />
                                <Chart3DPrimaryYAxis />
                                <Chart3DTooltipSettings Enable="true" />
                                <Chart3DLegendSettings Visible="false" />
                                <Chart3DSeriesCollection>
                                    <Chart3DSeries DataSource="@UnitChart"
                                                   XName="Label"
                                                   YName="Net"
                                                   Type="Chart3DSeriesType.Column"
                                                   Name="Net" />
                                </Chart3DSeriesCollection>
                            </SfChart3D>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="plSeries" SizeX="3" SizeY="3" Row="12" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-title d-flex justify-content-between align-items-center w-100">
                        <span>Portfolio net (YTD)</span>
                        <span class="small text-muted">zoom / pan</span>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px;">
                        @if (SeriesChart.Count == 0)
                        {
                            <p class="text-muted small p-2 mb-0">No period series yet.</p>
                        }
                        else
                        {
                            <SfChart @ref="_seriesChart" Width="100%" Height="100%" Theme="@ChartTheme">
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" />
                                <ChartZoomSettings EnableSelectionZooming="true"
                                                   EnableMouseWheelZooming="true"
                                                   Mode="Syncfusion.Blazor.Charts.ZoomMode.X"
                                                   EnableScrollbar="true" />
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Income" Type="ChartSeriesType.Line" Name="Income" />
                                    <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Expense" Type="ChartSeriesType.Line" Name="Expense" />
                                    <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Net" Type="ChartSeriesType.Column" Name="Net" />
                                </ChartSeriesCollection>
                                <ChartLegendSettings Visible="true" />
                            </SfChart>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
}

@code {
    private SfDashboardLayout? _layout;
    private SfChart? _collectionChart;
    private SfChart? _seriesChart;
    private DashboardSnapshot? Snap { get; set; }
    private string? ErrorMessage { get; set; }
    private List<ChartPoint> UnitChart { get; set; } = [];
    private List<ChartPoint> SeriesChart { get; set; } = [];
    private List<DashboardStatusSlice> StatusSlices { get; set; } = [];
    private List<DashboardMonthAmount> CollectionChart { get; set; } = [];
    private List<SparkPoint> CollectionSparkData { get; set; } = [];
    private List<DashboardHeatCell> HeatCells { get; set; } = [];
    private string[] HeatMonthLabels { get; set; } = [];
    private string[] HeatUnitLabels { get; set; } = [];
    private Theme ChartTheme { get; set; } = Theme.Fluent2;
    private string DisplayTime => Clock.ToDisplayTime(Clock.UtcNow).ToString("f");

    private string CollectionRateLabel
    {
        get
        {
            if (Snap is null || Snap.ExpectedRentThisMonth <= 0)
            {
                return "no expected rent set";
            }

            return $"{Snap.CollectionRatePercent:0.#}% of expected";
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var isDark = await JsRuntime.InvokeAsync<bool>("ClerkSuiteTheme.isDarkMode");
        var next = isDark ? Theme.Fluent2Dark : Theme.Fluent2;
        if (next != ChartTheme)
        {
            ChartTheme = next;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        ErrorMessage = null;
        try
        {
            Snap = await DashboardService.GetSnapshotAsync();
            StatusSlices = Snap.UnitStatusSlices.ToList();
            CollectionChart = Snap.CollectionByMonth.ToList();
            CollectionSparkData = Snap.CollectionByMonth
                .Select(m => new SparkPoint { Label = m.Label, Amount = (double)m.Amount })
                .ToList();
            HeatCells = Snap.PaymentHeatmap.ToList();
            HeatMonthLabels = Snap.PaymentHeatmap.Select(c => c.Month).Distinct().ToArray();
            HeatUnitLabels = Snap.PaymentHeatmap.Select(c => c.Unit).Distinct().OrderBy(u => u).ToArray();

            var pl = await ProfitLoss.GetAsync(ProfitLossPeriod.YearToDate);
            UnitChart = pl.ByUnit
                .Where(u => u.UnitId is not null)
                .Select(u => new ChartPoint { Label = u.UnitLabel, Net = (double)u.Net })
                .ToList();
            SeriesChart = pl.Series
                .Select(s => new ChartPoint
                {
                    Label = s.Label,
                    Income = (double)s.Income,
                    Expense = (double)s.Expense,
                    Net = (double)s.Net
                })
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task ExportChartsAsync()
    {
        if (_collectionChart is not null)
        {
            await _collectionChart.ExportAsync(Syncfusion.Blazor.Charts.ExportType.PNG, "clerksuite-rent-collected");
        }

        if (_seriesChart is not null)
        {
            await _seriesChart.ExportAsync(Syncfusion.Blazor.Charts.ExportType.PNG, "clerksuite-portfolio-net");
        }
    }

    private async Task ResetLayoutAsync()
    {
        if (_layout is null)
        {
            return;
        }

        await _layout.ResetPersistDataAsync();
        await _layout.RefreshAsync();
    }

    private sealed class ChartPoint
    {
        public string Label { get; set; } = "";
        public double Net { get; set; }
        public double Income { get; set; }
        public double Expense { get; set; }
    }

    private sealed class SparkPoint
    {
        public string Label { get; set; } = "";
        public double Amount { get; set; }
    }
}
