@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Layouts
@using Wiley.Apartments.Contracts
@inject IDashboardService DashboardService
@inject IPortfolioProfitLossService ProfitLoss
@inject IDateTimeService Clock
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>ClerkSuite Dashboard</PageTitle>

<PageHeader Title="ClerkSuite dashboard"
            Subtitle="@($"Occupancy, expirations, work orders, delinquencies, warranties · Mountain Time {DisplayTime}")">
    <SfButton CssClass="e-outline" Content="Refresh" OnClick="LoadAsync" />
</PageHeader>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}
else if (Snap is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="kpi-grid">
        <SfCard CssClass="kpi-card kpi-card--accent">
            <CardContent>
                <div class="kpi-label">Occupied</div>
                <div class="kpi-value"><a href="units">@Snap.Occupied / @Snap.TotalUnits</a></div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Vacant</div>
                <div class="kpi-value">@Snap.Vacant</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card kpi-card--warn">
            <CardContent>
                <div class="kpi-label">Open work orders</div>
                <div class="kpi-value"><a href="maintenance">@Snap.OpenWorkOrders.Count</a></div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card kpi-card--danger">
            <CardContent>
                <div class="kpi-label">Delinquent accounts</div>
                <div class="kpi-value"><a href="reports/delinquency">@Snap.Delinquencies.Count</a></div>
            </CardContent>
        </SfCard>
    </div>

    <SfDashboardLayout Columns="6" CellSpacing="@(new double[] { 14, 14 })" AllowResizing="false" AllowDragging="false">
        <DashboardLayoutPanels>
            <DashboardLayoutPanel Id="exp30" SizeX="3" SizeY="2" Row="0" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Leases expiring (≤30 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ExpiringLeasesWithin30.Count</span>
                            <a class="panel-view-all" href="leases">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ExpiringLeasesWithin30.Count == 0)
                        {
                            <p class="text-muted small mb-0">None in window.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var l in Snap.ExpiringLeasesWithin30)
                                {
                                    <li class="mb-1">
                                        <a href="@($"/leases/{l.LeaseId}")">Unit @l.UnitNumber</a>
                                        — @l.TenantName · @Clock.ToDisplayTime(l.EndUtc).ToString("d")
                                        (@l.DaysRemaining d)
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="exp60" SizeX="3" SizeY="2" Row="0" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Leases expiring (31–60 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ExpiringLeasesWithin60.Count</span>
                            <a class="panel-view-all" href="leases">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ExpiringLeasesWithin60.Count == 0)
                        {
                            <p class="text-muted small mb-0">None in window.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var l in Snap.ExpiringLeasesWithin60)
                                {
                                    <li class="mb-1">
                                        <a href="@($"/leases/{l.LeaseId}")">Unit @l.UnitNumber</a>
                                        — @l.TenantName · @Clock.ToDisplayTime(l.EndUtc).ToString("d")
                                        (@l.DaysRemaining d)
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="schedule" SizeX="3" SizeY="2" Row="2" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Schedule reminders (14 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ScheduleReminders.Count</span>
                            <a class="panel-view-all" href="schedule">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ScheduleReminders.Count == 0)
                        {
                            <p class="text-muted small mb-0">No upcoming reminders.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var s in Snap.ScheduleReminders)
                                {
                                    <li class="mb-1">
                                        <a href="schedule">Unit @s.UnitNumber</a>
                                        — @s.Title · @Clock.ToDisplayTime(s.ReminderUtc).ToString("d")
                                        (@s.Category)
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="wo" SizeX="3" SizeY="2" Row="4" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Open maintenance</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.OpenWorkOrders.Count</span>
                            <a class="panel-view-all" href="maintenance">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.OpenWorkOrders.Count == 0)
                        {
                            <p class="text-muted small mb-0">No open work orders.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var m in Snap.OpenWorkOrders)
                                {
                                    <li class="mb-1">
                                        <a href="maintenance">Unit @m.UnitNumber</a>
                                        · @m.Priority · @m.Description
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="delinq" SizeX="3" SizeY="2" Row="4" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Delinquencies</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.Delinquencies.Count</span>
                            <a class="panel-view-all" href="reports/delinquency">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.Delinquencies.Count == 0)
                        {
                            <p class="text-muted small mb-0">None.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var d in Snap.Delinquencies)
                                {
                                    <li class="mb-1">
                                        <a href="reports/delinquency">Unit @d.UnitNumber</a>
                                        — @d.TenantName · @d.Balance.ToString("C")
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="warranty" SizeX="3" SizeY="2" Row="6" Column="0">
                <HeaderTemplate>
                    <div class="panel-header-bar">
                        <div class="panel-header-title">Warranties (90 days)</div>
                        <div class="panel-header-meta">
                            <span class="panel-count">@Snap.ExpiringWarranties.Count</span>
                            <a class="panel-view-all" href="reports/warranty">View all</a>
                        </div>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="p-2" style="overflow:auto; height:100%;">
                        @if (Snap.ExpiringWarranties.Count == 0)
                        {
                            <p class="text-muted small mb-0">None expiring soon.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var w in Snap.ExpiringWarranties)
                                {
                                    <li class="mb-1">
                                        <a href="@($"/units/{w.UnitId}")">Unit @w.UnitNumber</a>
                                        — @w.AssetLabel · @w.WarrantyEnd.ToString("d")
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="plUnit" SizeX="3" SizeY="3" Row="6" Column="3">
                <HeaderTemplate>
                    <div class="panel-header-title d-flex justify-content-between align-items-center w-100">
                        <span>P/L by unit (YTD)</span>
                        <a class="small" href="reports/profit-loss">Full report</a>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px;">
                        @if (UnitChart.Count == 0)
                        {
                            <p class="text-muted small p-2 mb-0">No ledger/ops-cost data yet.</p>
                        }
                        else
                        {
                            <SfChart Width="100%" Height="100%" Theme="@ChartTheme">
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" LabelRotation="-45" />
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@UnitChart" XName="Label" YName="Net" Type="ChartSeriesType.Column" Name="Net" />
                                </ChartSeriesCollection>
                            </SfChart>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
            <DashboardLayoutPanel Id="plSeries" SizeX="6" SizeY="3" Row="9" Column="0">
                <HeaderTemplate><div class="panel-header-title">Portfolio net (YTD by month)</div></HeaderTemplate>
                <ContentTemplate>
                    <div style="height:100%; width:100%; padding:4px;">
                        @if (SeriesChart.Count == 0)
                        {
                            <p class="text-muted small p-2 mb-0">No period series yet.</p>
                        }
                        else
                        {
                            <SfChart Width="100%" Height="100%" Theme="@ChartTheme">
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" />
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Income" Type="ChartSeriesType.Line" Name="Income" />
                                    <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Expense" Type="ChartSeriesType.Line" Name="Expense" />
                                    <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Net" Type="ChartSeriesType.Column" Name="Net" />
                                </ChartSeriesCollection>
                                <ChartLegendSettings Visible="true" />
                            </SfChart>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
}

@code {
    private DashboardSnapshot? Snap { get; set; }
    private string? ErrorMessage { get; set; }
    private List<ChartPoint> UnitChart { get; set; } = [];
    private List<ChartPoint> SeriesChart { get; set; } = [];
    private Theme ChartTheme { get; set; } = Theme.Fluent2;
    private string DisplayTime => Clock.ToDisplayTime(Clock.UtcNow).ToString("f");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var isDark = await JsRuntime.InvokeAsync<bool>("ClerkSuiteTheme.isDarkMode");
        var next = isDark ? Theme.Fluent2Dark : Theme.Fluent2;
        if (next != ChartTheme)
        {
            ChartTheme = next;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        ErrorMessage = null;
        try
        {
            Snap = await DashboardService.GetSnapshotAsync();
            var pl = await ProfitLoss.GetAsync(ProfitLossPeriod.YearToDate);
            UnitChart = pl.ByUnit
                .Where(u => u.UnitId is not null)
                .Select(u => new ChartPoint { Label = u.UnitLabel, Net = (double)u.Net })
                .ToList();
            SeriesChart = pl.Series
                .Select(s => new ChartPoint
                {
                    Label = s.Label,
                    Income = (double)s.Income,
                    Expense = (double)s.Expense,
                    Net = (double)s.Net
                })
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private sealed class ChartPoint
    {
        public string Label { get; set; } = "";
        public double Net { get; set; }
        public double Income { get; set; }
        public double Expense { get; set; }
    }
}
