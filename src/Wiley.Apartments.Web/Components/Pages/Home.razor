@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Layouts
@using Syncfusion.Blazor.Buttons
@using Wiley.Apartments.Contracts

<PageTitle>ClerkSuite Dashboard</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Portfolio health for Town of Wiley units</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <p class="text-muted small mb-0 tabular-nums">
            @if (LoadedAtDisplay is not null)
            {
                <span>As of @LoadedAtDisplay</span>
            }
        </p>
        <SfButton CssClass="e-outline e-small"
                  Content="Refresh"
                  Disabled="@(IsLoading)"
                  OnClick="RefreshAsync" />
    </div>
</div>

@if (LoadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center gap-2" role="alert">
        <span>@LoadError</span>
        <SfButton CssClass="e-small e-outline" Content="Retry" OnClick="RefreshAsync" />
    </div>
}
else if (IsLoading || Snapshot is null)
{
    <div class="dashboard-skeleton" aria-busy="true" aria-live="polite">
        <div class="row g-3 mb-3">
            @for (var i = 0; i < 4; i++)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="skeleton-card">
                        <div class="skeleton-line w-40"></div>
                        <div class="skeleton-line w-60 skeleton-lg"></div>
                        <div class="skeleton-line w-80"></div>
                    </div>
                </div>
            }
        </div>
        <div class="row g-3 mb-3">
            <div class="col-lg-4"><div class="skeleton-card skeleton-tall"></div></div>
            <div class="col-lg-8"><div class="skeleton-card skeleton-tall"></div></div>
        </div>
        <div class="skeleton-card skeleton-table"></div>
        <p class="text-muted small mt-2 mb-0">Loading dashboard…</p>
    </div>
}
else
{
    <SfDashboardLayout Columns="12"
                       CellSpacing="@(new double[] { 12, 12 })"
                       CellAspectRatio="0.85"
                       MediaQuery="max-width: 768px"
                       AllowDragging="false"
                       AllowResizing="false"
                       CssClass="clerksuite-dashboard">
        <DashboardLayoutPanels>
            <DashboardLayoutPanel Id="kpi-occupancy" SizeX="3" SizeY="1" Row="0" Column="0">
                <HeaderTemplate><div>Occupancy</div></HeaderTemplate>
                <ContentTemplate>
                    <button type="button"
                            class="kpi-panel kpi-panel-btn @(StatusFilter == "Occupied" ? "is-active" : null)"
                            @onclick='() => ToggleStatusFilter("Occupied")'>
                        <p class="kpi-metric">@Snapshot.OccupancyRate.ToString("0.#")%</p>
                        <p class="kpi-sub">@Snapshot.OccupiedCount of @Snapshot.TotalUnits units occupied</p>
                        <p class="kpi-hint">Filter portfolio: Occupied</p>
                    </button>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="kpi-vacant" SizeX="3" SizeY="1" Row="0" Column="3">
                <HeaderTemplate><div>Vacant / Make-Ready</div></HeaderTemplate>
                <ContentTemplate>
                    <button type="button"
                            class="kpi-panel kpi-panel-btn @(StatusFilter is "Vacant" or "Make-Ready" ? "is-active" : null)"
                            @onclick="ToggleVacantMakeReadyFilter">
                        <p class="kpi-metric">@(Snapshot.VacantCount + Snapshot.MakeReadyCount)</p>
                        <p class="kpi-sub">@Snapshot.VacantCount vacant · @Snapshot.MakeReadyCount make-ready</p>
                        <p class="kpi-hint">Filter portfolio: Vacant + Make-Ready</p>
                    </button>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="kpi-workorders" SizeX="3" SizeY="1" Row="0" Column="6">
                <HeaderTemplate><div>Open work orders</div></HeaderTemplate>
                <ContentTemplate>
                    <div class="kpi-panel">
                        <p class="kpi-metric">@Snapshot.OpenWorkOrders</p>
                        <p class="kpi-sub">
                            <span class="badge text-bg-secondary fw-normal">Deferred</span>
                            Maintenance module not yet active
                        </p>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="kpi-delinquent" SizeX="3" SizeY="1" Row="0" Column="9">
                <HeaderTemplate><div>Delinquent</div></HeaderTemplate>
                <ContentTemplate>
                    <div class="kpi-panel">
                        <p class="kpi-metric">@Snapshot.DelinquentAmount.ToString("C0")</p>
                        <p class="kpi-sub">
                            <span class="badge text-bg-secondary fw-normal">Deferred</span>
                            Payments module not yet active
                        </p>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="status-mix" SizeX="4" SizeY="2" Row="1" Column="0">
                <HeaderTemplate><div>Portfolio mix</div></HeaderTemplate>
                <ContentTemplate>
                    <ul class="status-mix list-unstyled mb-0">
                        @foreach (var s in Snapshot.StatusBreakdown)
                        {
                            <li>
                                <button type="button"
                                        class="status-mix-btn @(StatusFilter == s.Name ? "is-active" : null)"
                                        @onclick="() => ToggleStatusFilter(s.Name)">
                                    <span>@s.Name</span>
                                    <strong class="tabular-nums">@s.Count</strong>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (StatusFilter is not null)
                    {
                        <button type="button" class="btn btn-link btn-sm px-0 mt-2" @onclick="ClearFilter">Clear filter</button>
                    }
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="warranties" SizeX="8" SizeY="2" Row="1" Column="4">
                <HeaderTemplate><div>Warranty alerts (90 days)</div></HeaderTemplate>
                <ContentTemplate>
                    @if (Snapshot.WarrantyAlerts.Count == 0)
                    {
                        <p class="text-muted mb-0 small">No warranties expiring in the next 90 days.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Unit</th>
                                        <th>Asset</th>
                                        <th>Ends</th>
                                        <th class="text-end">Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Snapshot.WarrantyAlerts)
                                    {
                                        <tr>
                                            <td><a href="@($"/units/{row.UnitId}")">@row.UnitNumber</a></td>
                                            <td>@row.AssetType</td>
                                            <td class="tabular-nums">@row.WarrantyEnd.ToString("MM/dd/yyyy")</td>
                                            <td class="text-end tabular-nums">
                                                <span class="@(row.DaysLeft <= 30 ? "text-warning fw-semibold" : null)">@row.DaysLeft</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="rent-roll" SizeX="12" SizeY="3" Row="3" Column="0">
                <HeaderTemplate>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 w-100">
                        <span>Unit portfolio</span>
                        @if (StatusFilter is not null)
                        {
                            <span class="badge text-bg-primary fw-normal">@FilterLabel</span>
                        }
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="portfolio-filters mb-2" role="group" aria-label="Status filter">
                        <button type="button"
                                class="filter-chip @(StatusFilter is null ? "is-active" : null)"
                                @onclick="ClearFilter">All (@Snapshot.TotalUnits)</button>
                        @foreach (var s in Snapshot.StatusBreakdown)
                        {
                            <button type="button"
                                    class="filter-chip @(StatusFilter == s.Name ? "is-active" : null)"
                                    @onclick="() => ToggleStatusFilter(s.Name)">
                                @s.Name (@s.Count)
                            </button>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Unit</th>
                                    <th>Status</th>
                                    <th class="text-end">Beds</th>
                                    <th class="text-end">Baths</th>
                                    <th class="text-end">Sq ft</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredUnits.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted small">No units match this filter.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in FilteredUnits)
                                    {
                                        <tr>
                                            <td><a href="@($"/units/{row.Id}")">@row.Number</a></td>
                                            <td>@row.Status</td>
                                            <td class="text-end tabular-nums">@row.Beds</td>
                                            <td class="text-end tabular-nums">@row.Baths</td>
                                            <td class="text-end tabular-nums">@row.SqFt.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
}

@code {
    [Inject] private IDashboardService DashboardService { get; set; } = default!;
    [Inject] private IDateTimeService DateTimeService { get; set; } = default!;

    private DashboardSnapshot? Snapshot { get; set; }
    private string? LoadError { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? StatusFilter { get; set; }
    private bool VacantMakeReadyMode { get; set; }
    private string? LoadedAtDisplay { get; set; }

    private IReadOnlyList<UnitStatusRow> FilteredUnits
    {
        get
        {
            if (Snapshot is null)
            {
                return Array.Empty<UnitStatusRow>();
            }

            if (VacantMakeReadyMode)
            {
                return Snapshot.Units
                    .Where(u => u.Status is "Vacant" or "Make-Ready")
                    .ToList();
            }

            if (StatusFilter is null)
            {
                return Snapshot.Units;
            }

            return Snapshot.Units.Where(u => u.Status == StatusFilter).ToList();
        }
    }

    private string FilterLabel => VacantMakeReadyMode
        ? "Vacant + Make-Ready"
        : StatusFilter ?? "All";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        LoadError = null;
        try
        {
            Snapshot = await DashboardService.GetSnapshotAsync();
            LoadedAtDisplay = DateTimeService.ToDisplayTime(DateTimeService.UtcNow).ToString("f");
        }
        catch (Exception ex)
        {
            Snapshot = null;
            LoadError = "Could not load dashboard. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleStatusFilter(string status)
    {
        VacantMakeReadyMode = false;
        StatusFilter = StatusFilter == status ? null : status;
    }

    private void ToggleVacantMakeReadyFilter()
    {
        if (VacantMakeReadyMode)
        {
            VacantMakeReadyMode = false;
            StatusFilter = null;
            return;
        }

        VacantMakeReadyMode = true;
        StatusFilter = null;
    }

    private void ClearFilter()
    {
        StatusFilter = null;
        VacantMakeReadyMode = false;
    }
}
