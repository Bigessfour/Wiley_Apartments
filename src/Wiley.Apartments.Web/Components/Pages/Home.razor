@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Charts
@using Syncfusion.Blazor.Chart3D
@using Syncfusion.Blazor.CircularGauge
@using Syncfusion.Blazor.LinearGauge
@using Syncfusion.Blazor.Sparkline
@using Wiley.Apartments.Contracts
@inject IDashboardService DashboardService
@inject IPortfolioProfitLossService ProfitLoss
@inject IDateTimeService Clock
@inject NavigationManager Navigation
@inject ClerkSuiteThemeState ThemeState
@inject ILogger<Home> Logger
@implements IDisposable

<PageTitle>ClerkSuite Dashboard</PageTitle>

<PageHeader Title="ClerkSuite dashboard"
            Subtitle="@HeaderSubtitle">
    <SfButton CssClass="e-outline" Content="Refresh" Disabled="@IsLoading" OnClick="LoadAsync" />
    <SfButton CssClass="e-outline" Content="Export charts" OnClick="ExportChartsAsync" Disabled="@(Snap is null || IsLoading)" />
</PageHeader>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center gap-2" role="alert">
        <span>@ErrorMessage</span>
        <SfButton CssClass="e-small e-outline" Content="Retry" OnClick="LoadAsync" />
    </div>
}
else if (IsLoading || Snap is null)
{
    <div class="dashboard-skeleton" aria-busy="true" aria-live="polite">
        <div class="kpi-grid kpi-grid--viz">
            @for (var i = 0; i < 5; i++)
            {
                <div class="skeleton-card skeleton-kpi"></div>
            }
        </div>
        <div class="skeleton-card skeleton-panel mt-3"></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6"><div class="skeleton-card skeleton-panel"></div></div>
            <div class="col-md-6"><div class="skeleton-card skeleton-panel"></div></div>
        </div>
        <p class="text-muted small mt-2 mb-0">Loading portfolio snapshot…</p>
    </div>
}
else
{
    <div @key="ChartTheme">
    <div class="kpi-grid kpi-grid--viz">
        <SfCard CssClass="kpi-card kpi-card--accent kpi-card--gauge kpi-card--link" @onclick='() => Go("units")'>
            <CardContent>
                <div class="kpi-label">Occupancy</div>
                <div class="kpi-gauge-wrap">
                    <SfCircularGauge Height="120px" Width="100%" Theme="@ChartTheme">
                        <CircularGaugeAxes>
                            <CircularGaugeAxis StartAngle="210" EndAngle="150" Minimum="0" Maximum="100">
                                <CircularGaugeAxisMajorTicks Height="0" />
                                <CircularGaugeAxisMinorTicks Height="0" />
                                <CircularGaugeAxisLabelStyle Format=" " />
                                <CircularGaugeRanges>
                                    <CircularGaugeRange Start="0" End="100" Color="@ThemeState.GaugeTrackColor" StartWidth="12" EndWidth="12" Radius="90%" />
                                </CircularGaugeRanges>
                                <CircularGaugePointers>
                                    <CircularGaugePointer Value="@Snap.OccupancyPercent"
                                                          Type="PointerType.RangeBar"
                                                          PointerWidth="12"
                                                          Color="@ThemeState.AccentColor"
                                                          Radius="90%"
                                                          RoundedCornerRadius="6" />
                                </CircularGaugePointers>
                                <CircularGaugeAnnotations>
                                    <CircularGaugeAnnotation Content="@($"{Snap.OccupancyPercent:0.#}%")" Angle="180" Radius="0%" ZIndex="1">
                                        <CircularGaugeAnnotationTextStyle Size="18px" FontWeight="600" Color="@ThemeState.GaugeLabelColor" />
                                    </CircularGaugeAnnotation>
                                </CircularGaugeAnnotations>
                            </CircularGaugeAxis>
                        </CircularGaugeAxes>
                    </SfCircularGauge>
                </div>
                <div class="kpi-sub">@Snap.Occupied / @Snap.TotalUnits occupied · open units</div>
            </CardContent>
        </SfCard>

        <SfCard CssClass="kpi-card kpi-card--link" @onclick='() => Go("units?status=Empty")'>
            <CardContent>
                <div class="kpi-label">Vacant / Make-Ready</div>
                <div class="kpi-value">@(Snap.Vacant + Snap.MakeReady)</div>
                <div class="kpi-sub">@Snap.Vacant vacant · @Snap.MakeReady make-ready</div>
            </CardContent>
        </SfCard>

        <SfCard CssClass="kpi-card kpi-card--link" @onclick='() => Go("payments")'>
            <CardContent>
                <div class="kpi-label">Collected this month</div>
                <div class="kpi-value">@Snap.CollectedThisMonth.ToString("C0")</div>
                <div class="kpi-sub">Expected @Snap.ExpectedRentThisMonth.ToString("C0") · @CollectionRateLabel</div>
                <div class="kpi-linear-gauge">
                    <SfLinearGauge Height="56px" Width="100%" Theme="@ChartTheme">
                        <LinearGaugeAxes>
                            <LinearGaugeAxis Minimum="0" Maximum="@(Math.Max(100, Snap.CollectionRatePercent))">
                                <LinearGaugeAxisLabelStyle Format="{value}%" />
                                <LinearGaugePointers>
                                    <LinearGaugePointer PointerValue="@Snap.CollectionRatePercent"
                                                        Type="Syncfusion.Blazor.LinearGauge.Point.Bar"
                                                        Color="@ThemeState.AccentColor"
                                                        Width="12" />
                                </LinearGaugePointers>
                            </LinearGaugeAxis>
                        </LinearGaugeAxes>
                    </SfLinearGauge>
                </div>
                @if (CollectionSparkData.Count > 0)
                {
                    <div class="kpi-spark">
                        <SfSparkline TValue="SparkPoint"
                                     DataSource="@CollectionSparkData"
                                     XName="Label"
                                     YName="Amount"
                                     Type="SparklineType.Area"
                                     Height="28px"
                                     Width="100%"
                                     Fill="@ThemeState.AccentColor"
                                     LineWidth="1.5"
                                     Theme="@ChartTheme">
                        </SfSparkline>
                    </div>
                }
            </CardContent>
        </SfCard>

        <SfCard CssClass="kpi-card kpi-card--danger kpi-card--link" @onclick='() => Go("reports/delinquency")'>
            <CardContent>
                <div class="kpi-label">Outstanding</div>
                <div class="kpi-value">@Snap.OutstandingBalanceTotal.ToString("C0")</div>
                <div class="kpi-sub">@Snap.Delinquencies.Count current occupant(s)</div>
            </CardContent>
        </SfCard>

        <SfCard CssClass="kpi-card kpi-card--warn kpi-card--link" @onclick='() => Go("maintenance")'>
            <CardContent>
                <div class="kpi-label">Open work orders</div>
                <div class="kpi-value">@Snap.OpenWorkOrders.Count</div>
                <div class="kpi-sub">Maintenance queue</div>
            </CardContent>
        </SfCard>
    </div>

    <div class="home-dash-grid">
        <section class="home-dash-panel home-dash-panel--chart">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Units by status</div>
                </div>
            </header>
            <div class="home-dash-body">
                @if (StatusSlices.Count == 0)
                {
                    <p class="text-muted small p-2 mb-0">No unit status data yet.</p>
                }
                else
                {
                    @* LegendBorder required — Syncfusion NREs in CreateLegendElements when it is null. *@
                    <SfAccumulationChart Width="100%" Height="280px" Theme="@ChartTheme" EnableSmartLabels="true"
                                         EnableAnimation="false"
                                         EnableBorderOnMouseMove="false">
                        <AccumulationChartLegendSettings Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                            <AccumulationChartLegendBorder Color="transparent" Width="0" />
                        </AccumulationChartLegendSettings>
                        <AccumulationChartTooltipSettings Enable="true" Format="${point.x}: <b>${point.y}</b>" />
                        <AccumulationChartSeriesCollection>
                            <AccumulationChartSeries DataSource="@StatusSlices"
                                                     XName="Status"
                                                     YName="Count"
                                                     Name="Units"
                                                     InnerRadius="55%"
                                                     Radius="80%"
                                                     Type="AccumulationType.Pie">
                                <AccumulationDataLabelSettings Visible="true" Name="Status"
                                                               Position="AccumulationLabelPosition.Outside">
                                    <AccumulationChartDataLabelFont Color="@ThemeState.GaugeLabelColor" Size="12px" />
                                    <AccumulationChartConnector Color="@ThemeState.GaugeLabelColor" Length="8%" />
                                </AccumulationDataLabelSettings>
                            </AccumulationChartSeries>
                        </AccumulationChartSeriesCollection>
                    </SfAccumulationChart>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--chart">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Rent collected (12 months)</div>
                    <div class="panel-header-meta">
                        <span class="small text-muted">zoom / pan</span>
                    </div>
                </div>
            </header>
            <div class="home-dash-body">
                @if (CollectionChart.Count == 0 || CollectionChart.All(c => c.Amount == 0))
                {
                    <p class="text-muted small p-2 mb-0">No non-deposit payments in the last 12 months.</p>
                }
                else
                {
                    <SfChart @ref="_collectionChart" Width="100%" Height="280px" Theme="@ChartTheme">
                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"
                                           LabelIntersectAction="Syncfusion.Blazor.Charts.LabelIntersectAction.Trim" />
                        <ChartPrimaryYAxis LabelFormat="C0" />
                        <ChartTooltipSettings Enable="true" />
                        <ChartLegendSettings Visible="false">
                            <ChartLegendBorder Color="transparent" Width="0" />
                        </ChartLegendSettings>
                        <ChartZoomSettings EnableSelectionZooming="true"
                                           EnableMouseWheelZooming="true"
                                           EnablePinchZooming="true"
                                           Mode="Syncfusion.Blazor.Charts.ZoomMode.X"
                                           EnableScrollbar="true" />
                        <ChartSeriesCollection>
                            <ChartSeries DataSource="@CollectionChart"
                                         XName="Label"
                                         YName="Amount"
                                         Type="ChartSeriesType.Column"
                                         Name="Collected" />
                        </ChartSeriesCollection>
                    </SfChart>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--list">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Leases expiring (≤30 days)</div>
                    <div class="panel-header-meta">
                        <span class="panel-count">@Snap.ExpiringLeasesWithin30.Count</span>
                        <a class="panel-view-all" href="leases">View all</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body home-dash-body--scroll">
                @if (Snap.ExpiringLeasesWithin30.Count == 0)
                {
                    <p class="text-muted small mb-0">None in window.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var l in Snap.ExpiringLeasesWithin30)
                        {
                            <li class="mb-1 @UrgencyClass(l.DaysRemaining)">
                                <a href="@($"/leases/{l.LeaseId}")">Unit @l.UnitNumber</a>
                                — @l.TenantName · @Clock.ToDisplayTime(l.EndUtc).ToString("d")
                                <span class="days-pill">@l.DaysRemaining d</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--list">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Leases expiring (31–60 days)</div>
                    <div class="panel-header-meta">
                        <span class="panel-count">@Snap.ExpiringLeasesWithin60.Count</span>
                        <a class="panel-view-all" href="leases">View all</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body home-dash-body--scroll">
                @if (Snap.ExpiringLeasesWithin60.Count == 0)
                {
                    <p class="text-muted small mb-0">None in window.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var l in Snap.ExpiringLeasesWithin60)
                        {
                            <li class="mb-1 @UrgencyClass(l.DaysRemaining)">
                                <a href="@($"/leases/{l.LeaseId}")">Unit @l.UnitNumber</a>
                                — @l.TenantName · @Clock.ToDisplayTime(l.EndUtc).ToString("d")
                                <span class="days-pill">@l.DaysRemaining d</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--list">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Open maintenance</div>
                    <div class="panel-header-meta">
                        <span class="panel-count">@Snap.OpenWorkOrders.Count</span>
                        <a class="panel-view-all" href="maintenance">View all</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body home-dash-body--scroll">
                @if (Snap.OpenWorkOrders.Count == 0)
                {
                    <p class="text-muted small mb-0">No open work orders.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var m in Snap.OpenWorkOrders)
                        {
                            <li class="mb-1">
                                <a href="@($"maintenance?unitId={m.UnitId}")">Unit @m.UnitNumber</a>
                                · @m.Priority · @m.Description
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--list">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Schedule reminders (14 days)</div>
                    <div class="panel-header-meta">
                        <span class="panel-count">@Snap.ScheduleReminders.Count</span>
                        <a class="panel-view-all" href="schedule">View all</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body home-dash-body--scroll">
                @if (Snap.ScheduleReminders.Count == 0)
                {
                    <p class="text-muted small mb-0">No upcoming reminders.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var s in Snap.ScheduleReminders)
                        {
                            <li class="mb-1">
                                <a href="schedule">Unit @s.UnitNumber</a>
                                — @s.Title · @Clock.ToDisplayTime(s.ReminderUtc).ToString("d")
                                (@s.Category)
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--list">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Warranties (90 days)</div>
                    <div class="panel-header-meta">
                        <span class="panel-count">@Snap.ExpiringWarranties.Count</span>
                        <a class="panel-view-all" href="reports/warranty">View all</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body home-dash-body--scroll">
                @if (Snap.ExpiringWarranties.Count == 0)
                {
                    <p class="text-muted small mb-0">None expiring soon.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var w in Snap.ExpiringWarranties)
                        {
                            <li class="mb-1 @UrgencyClass(w.DaysRemaining)">
                                <a href="@($"/units/{w.UnitId}")">Unit @w.UnitNumber</a>
                                — @w.AssetLabel · @w.WarrantyEnd.ToString("d")
                                <span class="days-pill">@w.DaysRemaining d</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--list">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Delinquencies</div>
                    <div class="panel-header-meta">
                        <span class="panel-count">@Snap.Delinquencies.Count</span>
                        <a class="panel-view-all" href="reports/delinquency">View all</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body home-dash-body--scroll">
                @if (Snap.Delinquencies.Count == 0)
                {
                    <p class="text-muted small mb-0">No current occupants past due.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var d in Snap.Delinquencies)
                        {
                            <li class="mb-1">
                                <a href="reports/delinquency">Unit @d.UnitNumber</a>
                                — @d.TenantName · @d.Balance.ToString("C")
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--chart">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">P/L by unit (YTD, 3D)</div>
                    <div class="panel-header-meta">
                        <a class="panel-view-all" href="reports/profit-loss">Full report</a>
                    </div>
                </div>
            </header>
            <div class="home-dash-body">
                @if (UnitChart.Count == 0)
                {
                    <p class="text-muted small p-2 mb-0">No ledger/ops-cost data yet.</p>
                }
                else
                {
                    <SfChart3D Width="100%"
                               Height="280px"
                               Theme="@ChartTheme"
                               EnableRotation="true"
                               RotationAngle="22"
                               Depth="100"
                               TiltAngle="10">
                        <Chart3DPrimaryXAxis ValueType="Syncfusion.Blazor.Chart3D.ValueType.Category"
                                             LabelRotationAngle="-45"
                                             LabelIntersectAction="Syncfusion.Blazor.Chart3D.LabelIntersectAction.Rotate45" />
                        <Chart3DPrimaryYAxis />
                        <Chart3DTooltipSettings Enable="true" />
                        <Chart3DLegendSettings Visible="false" />
                        <Chart3DSeriesCollection>
                            <Chart3DSeries DataSource="@UnitChart"
                                           XName="Label"
                                           YName="Net"
                                           Type="Chart3DSeriesType.Column"
                                           Name="Net" />
                        </Chart3DSeriesCollection>
                    </SfChart3D>
                }
            </div>
        </section>

        <section class="home-dash-panel home-dash-panel--chart">
            <header class="home-dash-header">
                <div class="panel-header-bar">
                    <div class="panel-header-title">Portfolio net (YTD)</div>
                    <div class="panel-header-meta">
                        <span class="small text-muted">zoom / pan</span>
                    </div>
                </div>
            </header>
            <div class="home-dash-body">
                @if (SeriesChart.Count == 0)
                {
                    <p class="text-muted small p-2 mb-0">No period series yet.</p>
                }
                else
                {
                    <SfChart @ref="_seriesChart" Width="100%" Height="280px" Theme="@ChartTheme">
                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" />
                        <ChartZoomSettings EnableSelectionZooming="true"
                                           EnableMouseWheelZooming="true"
                                           Mode="Syncfusion.Blazor.Charts.ZoomMode.X"
                                           EnableScrollbar="true" />
                        <ChartSeriesCollection>
                            <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Income" Type="ChartSeriesType.Line" Name="Income" />
                            <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Expense" Type="ChartSeriesType.Line" Name="Expense" />
                            <ChartSeries DataSource="@SeriesChart" XName="Label" YName="Net" Type="ChartSeriesType.Column" Name="Net" />
                        </ChartSeriesCollection>
                        <ChartLegendSettings Visible="true">
                            <ChartLegendBorder Color="transparent" Width="0" />
                        </ChartLegendSettings>
                    </SfChart>
                }
            </div>
        </section>
    </div>
    </div>
}

@code {
    private SfChart? _collectionChart;
    private SfChart? _seriesChart;
    private DashboardSnapshot? Snap { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;
    private List<ChartPoint> UnitChart { get; set; } = [];
    private List<ChartPoint> SeriesChart { get; set; } = [];
    private List<DashboardStatusSlice> StatusSlices { get; set; } = [];
    private List<DashboardMonthAmount> CollectionChart { get; set; } = [];
    private List<SparkPoint> CollectionSparkData { get; set; } = [];
    private Theme ChartTheme => ThemeState.ChartTheme;

    private string HeaderSubtitle
    {
        get
        {
            if (Snap is null)
            {
                return "Occupancy, collection, expirations, work orders · Mountain Time";
            }

            var asOf = Clock.ToDisplayTime(Snap.GeneratedUtc).ToString("f");
            return $"Occupancy, collection, expirations, work orders · As of {asOf} MT";
        }
    }

    private string CollectionRateLabel
    {
        get
        {
            if (Snap is null || Snap.ExpectedRentThisMonth <= 0)
            {
                return "no expected rent set";
            }

            return $"{Snap.CollectionRatePercent:0.#}% of expected";
        }
    }

    protected override void OnInitialized()
    {
        ThemeState.Changed += OnThemeStateChanged;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void OnThemeStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeStateChanged;

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            // Sequential: shared scoped DbContext is not safe for concurrent use.
            Snap = await DashboardService.GetSnapshotAsync();
            StatusSlices = Snap.UnitStatusSlices.ToList();
            CollectionChart = Snap.CollectionByMonth.ToList();
            CollectionSparkData = Snap.CollectionByMonth
                .Select(m => new SparkPoint { Label = m.Label, Amount = (double)m.Amount })
                .ToList();

            var pl = await ProfitLoss.GetAsync(ProfitLossPeriod.YearToDate);
            UnitChart = pl.ByUnit
                .Where(u => u.UnitId is not null)
                .Select(u => new ChartPoint { Label = u.UnitLabel, Net = (double)u.Net })
                .ToList();
            SeriesChart = pl.Series
                .Select(s => new ChartPoint
                {
                    Label = s.Label,
                    Income = (double)s.Income,
                    Expense = (double)s.Expense,
                    Net = (double)s.Net
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard load failed.");
            Snap = null;
            ErrorMessage = "Could not load dashboard. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void Go(string path) => Navigation.NavigateTo(path);

    private async Task ExportChartsAsync()
    {
        if (_collectionChart is not null)
        {
            await _collectionChart.ExportAsync(Syncfusion.Blazor.Charts.ExportType.PNG, "clerksuite-rent-collected");
        }

        if (_seriesChart is not null)
        {
            await _seriesChart.ExportAsync(Syncfusion.Blazor.Charts.ExportType.PNG, "clerksuite-portfolio-net");
        }
    }

    private static string UrgencyClass(int daysRemaining) => daysRemaining switch
    {
        <= 7 => "urgency-critical",
        <= 30 => "urgency-soon",
        _ => string.Empty,
    };

    private sealed class ChartPoint
    {
        public string Label { get; set; } = "";
        public double Net { get; set; }
        public double Income { get; set; }
        public double Expense { get; set; }
    }

    private sealed class SparkPoint
    {
        public string Label { get; set; } = "";
        public double Amount { get; set; }
    }
}
