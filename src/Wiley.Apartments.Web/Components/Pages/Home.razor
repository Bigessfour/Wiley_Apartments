@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Syncfusion.Blazor.Layouts
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Wiley.Apartments.Contracts

<PageTitle>ClerkSuite Dashboard</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Portfolio health — Town of Wiley Apartments</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (LoadedAtDisplay is not null)
        {
            <p class="text-muted small mb-0 tabular-nums">As of @LoadedAtDisplay</p>
        }
        <SfButton CssClass="e-outline e-small"
                  Content="Refresh"
                  Disabled="@IsLoading"
                  OnClick="RefreshAsync" />
        <SfButton CssClass="e-flat e-small"
                  Content="All units"
                  OnClick='() => Nav.NavigateTo("/units")' />
    </div>
</div>

@if (LoadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center gap-2" role="alert">
        <span>@LoadError</span>
        <SfButton CssClass="e-small e-outline" Content="Retry" OnClick="RefreshAsync" />
    </div>
}
else if (IsLoading || Snapshot is null)
{
    <div class="dashboard-skeleton" aria-busy="true" aria-live="polite">
        <div class="row g-3 mb-3">
            @for (var i = 0; i < 4; i++)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="skeleton-card">
                        <div class="skeleton-line w-40"></div>
                        <div class="skeleton-line w-60 skeleton-lg"></div>
                        <div class="skeleton-line w-80"></div>
                    </div>
                </div>
            }
        </div>
        <div class="row g-3 mb-3">
            <div class="col-lg-4"><div class="skeleton-card skeleton-tall"></div></div>
            <div class="col-lg-8"><div class="skeleton-card skeleton-tall"></div></div>
        </div>
        <div class="skeleton-card skeleton-table"></div>
        <p class="text-muted small mt-2 mb-0">Loading dashboard…</p>
    </div>
}
else
{
    <SfDashboardLayout Columns="12"
                       CellSpacing="@(new double[] { 12, 12 })"
                       CellAspectRatio="0.85"
                       MediaQuery="max-width: 768px"
                       AllowDragging="false"
                       AllowResizing="false"
                       CssClass="clerksuite-dashboard">
        <DashboardLayoutPanels>
            <DashboardLayoutPanel Id="kpi-occupancy" SizeX="3" SizeY="1" Row="0" Column="0">
                <HeaderTemplate><div>Occupancy</div></HeaderTemplate>
                <ContentTemplate>
                    <button type="button"
                            class="kpi-panel kpi-panel-btn @(StatusFilter == "Occupied" ? "is-active" : null)"
                            @onclick='() => ToggleStatusFilter("Occupied")'>
                        <p class="kpi-metric">@Snapshot.OccupancyRate.ToString("0.#")%</p>
                        <div class="occupancy-bar" aria-hidden="true">
                            <div class="occupancy-bar-fill" style="width: @($"{Math.Clamp(Snapshot.OccupancyRate, 0, 100):0.#}%")"></div>
                        </div>
                        <p class="kpi-sub">@Snapshot.OccupiedCount of @Snapshot.TotalUnits units occupied</p>
                        <p class="kpi-hint">Filter portfolio · Occupied</p>
                    </button>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="kpi-vacant" SizeX="3" SizeY="1" Row="0" Column="3">
                <HeaderTemplate><div>Vacant / Make-Ready</div></HeaderTemplate>
                <ContentTemplate>
                    <button type="button"
                            class="kpi-panel kpi-panel-btn @(VacantMakeReadyMode ? "is-active" : null)"
                            @onclick="ToggleVacantMakeReadyFilter">
                        <p class="kpi-metric">@(Snapshot.VacantCount + Snapshot.MakeReadyCount)</p>
                        <p class="kpi-sub">@Snapshot.VacantCount vacant · @Snapshot.MakeReadyCount make-ready</p>
                        <p class="kpi-hint">Filter portfolio · Vacant + Make-Ready</p>
                    </button>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="kpi-maintenance" SizeX="3" SizeY="1" Row="0" Column="6">
                <HeaderTemplate><div>Maintenance</div></HeaderTemplate>
                <ContentTemplate>
                    <button type="button"
                            class="kpi-panel kpi-panel-btn @(StatusFilter == "Maintenance" ? "is-active" : null)"
                            @onclick='() => ToggleStatusFilter("Maintenance")'>
                        <p class="kpi-metric">@Snapshot.MaintenanceCount</p>
                        <p class="kpi-sub">Units marked maintenance</p>
                        <p class="kpi-hint">Filter portfolio · Maintenance</p>
                    </button>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="kpi-warranties" SizeX="3" SizeY="1" Row="0" Column="9">
                <HeaderTemplate><div>Warranty alerts</div></HeaderTemplate>
                <ContentTemplate>
                    <div class="kpi-panel">
                        <p class="kpi-metric">@Snapshot.WarrantyAlerts.Count</p>
                        <p class="kpi-sub">Assets ending in next 90 days</p>
                        <p class="kpi-hint">Live from asset records</p>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="status-mix" SizeX="4" SizeY="2" Row="1" Column="0">
                <HeaderTemplate><div>Portfolio mix</div></HeaderTemplate>
                <ContentTemplate>
                    @if (Snapshot.TotalUnits > 0)
                    {
                        <div class="mix-bar" role="img" aria-label="Portfolio status mix">
                            @foreach (var s in Snapshot.StatusBreakdown)
                            {
                                var pct = 100.0 * s.Count / Snapshot.TotalUnits;
                                <div class="mix-seg mix-@CssStatusKey(s.Name)"
                                     style="width: @($"{pct:0.#}%")"
                                     title="@($"{s.Name}: {s.Count}")"></div>
                            }
                        </div>
                    }
                    <ul class="status-mix list-unstyled mb-0 mt-2">
                        @foreach (var s in Snapshot.StatusBreakdown)
                        {
                            <li>
                                <button type="button"
                                        class="status-mix-btn @(StatusFilter == s.Name ? "is-active" : null)"
                                        @onclick="() => ToggleStatusFilter(s.Name)">
                                    <span class="status-dot mix-@CssStatusKey(s.Name)"></span>
                                    <span>@s.Name</span>
                                    <strong class="tabular-nums ms-auto">@s.Count</strong>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (StatusFilter is not null || VacantMakeReadyMode)
                    {
                        <button type="button" class="btn btn-link btn-sm px-0 mt-2" @onclick="ClearFilter">Clear filter</button>
                    }
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="warranties" SizeX="8" SizeY="2" Row="1" Column="4">
                <HeaderTemplate><div>Warranty alerts (90 days)</div></HeaderTemplate>
                <ContentTemplate>
                    @if (Snapshot.WarrantyAlerts.Count == 0)
                    {
                        <p class="text-muted mb-0 small">No warranties expiring in the next 90 days.</p>
                    }
                    else
                    {
                        <SfGrid TValue="WarrantyAlertItem"
                                DataSource="@Snapshot.WarrantyAlerts"
                                AllowSorting="true"
                                AllowPaging="true"
                                Height="220"
                                GridLines="GridLine.Horizontal">
                            <GridPageSettings PageSize="6" />
                            <GridColumns>
                                <GridColumn Field="@nameof(WarrantyAlertItem.UnitNumber)" HeaderText="Unit" Width="90">
                                    <Template>
                                        @{
                                            var row = context as WarrantyAlertItem;
                                        }
                                        @if (row is not null)
                                        {
                                            <a href="@($"/units/{row.UnitId}")">@row.UnitNumber</a>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(WarrantyAlertItem.AssetType)" HeaderText="Asset" Width="140" />
                                <GridColumn Field="@nameof(WarrantyAlertItem.WarrantyEnd)"
                                            HeaderText="Ends"
                                            Width="110"
                                            TextAlign="TextAlign.Right">
                                    <Template>
                                        @{
                                            var row = context as WarrantyAlertItem;
                                        }
                                        @if (row is not null)
                                        {
                                            <span class="tabular-nums">@row.WarrantyEnd.ToString("MM/dd/yyyy")</span>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(WarrantyAlertItem.DaysLeft)"
                                            HeaderText="Days"
                                            Width="80"
                                            TextAlign="TextAlign.Right">
                                    <Template>
                                        @{
                                            var row = context as WarrantyAlertItem;
                                        }
                                        @if (row is not null)
                                        {
                                            <span class="tabular-nums @(row.DaysLeft <= 30 ? "text-warning fw-semibold" : null)">@row.DaysLeft</span>
                                        }
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    }
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="pipeline" SizeX="12" SizeY="1" Row="3" Column="0">
                <HeaderTemplate><div>Coming modules</div></HeaderTemplate>
                <ContentTemplate>
                    <div class="pipeline-row">
                        <div class="pipeline-card">
                            <strong>Lease expirations</strong>
                            <span class="badge text-bg-secondary fw-normal">Phase 3</span>
                            <p class="small text-muted mb-0">Needs Lease entity (T3.x) — not in domain yet.</p>
                        </div>
                        <div class="pipeline-card">
                            <strong>Work orders</strong>
                            <span class="badge text-bg-secondary fw-normal">Phase 4</span>
                            <p class="small text-muted mb-0">Needs MaintenanceRequest — open WO KPI will wire here.</p>
                        </div>
                        <div class="pipeline-card">
                            <strong>Delinquencies</strong>
                            <span class="badge text-bg-secondary fw-normal">Phase 3</span>
                            <p class="small text-muted mb-0">Needs LedgerEntry payments — balance KPIs deferred.</p>
                        </div>
                        <div class="pipeline-card">
                            <strong>Tenants</strong>
                            <span class="badge text-bg-secondary fw-normal">Phase 2</span>
                            <p class="small text-muted mb-0">
                                <a href="/tenants">Tenants page</a> stub — Unit.CurrentTenantId reserved, no Tenant table yet.
                            </p>
                        </div>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <DashboardLayoutPanel Id="rent-roll" SizeX="12" SizeY="3" Row="4" Column="0">
                <HeaderTemplate>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 w-100">
                        <span>Unit portfolio</span>
                        @if (StatusFilter is not null || VacantMakeReadyMode)
                        {
                            <span class="badge text-bg-primary fw-normal">@FilterLabel · @FilteredUnits.Count</span>
                        }
                        else
                        {
                            <span class="text-muted small">@Snapshot.TotalUnits units</span>
                        }
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="portfolio-filters mb-2" role="group" aria-label="Status filter">
                        <button type="button"
                                class="filter-chip @(StatusFilter is null && !VacantMakeReadyMode ? "is-active" : null)"
                                @onclick="ClearFilter">All (@Snapshot.TotalUnits)</button>
                        @foreach (var s in Snapshot.StatusBreakdown)
                        {
                            <button type="button"
                                    class="filter-chip @(StatusFilter == s.Name ? "is-active" : null)"
                                    @onclick="() => ToggleStatusFilter(s.Name)">
                                @s.Name (@s.Count)
                            </button>
                        }
                    </div>
                    <SfGrid TValue="UnitStatusRow"
                            DataSource="@FilteredUnits"
                            AllowSorting="true"
                            AllowPaging="true"
                            Height="280"
                            GridLines="GridLine.Horizontal">
                        <GridPageSettings PageSize="10" />
                        <GridColumns>
                            <GridColumn Field="@nameof(UnitStatusRow.Number)" HeaderText="Unit" Width="100">
                                <Template>
                                    @{
                                        var row = context as UnitStatusRow;
                                    }
                                    @if (row is not null)
                                    {
                                        <a href="@($"/units/{row.Id}")">@row.Number</a>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(UnitStatusRow.Status)" HeaderText="Status" Width="130">
                                <Template>
                                    @{
                                        var row = context as UnitStatusRow;
                                    }
                                    @if (row is not null)
                                    {
                                        <span class="badge @StatusBadgeClass(row.Status)">@row.Status</span>
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(UnitStatusRow.Beds)"
                                        HeaderText="Beds"
                                        Width="80"
                                        TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(UnitStatusRow.Baths)"
                                        HeaderText="Baths"
                                        Width="80"
                                        TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(UnitStatusRow.SqFt)"
                                        HeaderText="Sq ft"
                                        Width="100"
                                        Format="N0"
                                        TextAlign="TextAlign.Right" />
                        </GridColumns>
                    </SfGrid>
                </ContentTemplate>
            </DashboardLayoutPanel>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
}

@code {
    [Inject] private IDashboardService DashboardService { get; set; } = default!;
    [Inject] private IDateTimeService DateTimeService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private DashboardSnapshot? Snapshot { get; set; }
    private string? LoadError { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? StatusFilter { get; set; }
    private bool VacantMakeReadyMode { get; set; }
    private string? LoadedAtDisplay { get; set; }

    private IReadOnlyList<UnitStatusRow> FilteredUnits
    {
        get
        {
            if (Snapshot is null)
            {
                return Array.Empty<UnitStatusRow>();
            }

            if (VacantMakeReadyMode)
            {
                return Snapshot.Units
                    .Where(u => u.Status is "Vacant" or "Make-Ready")
                    .ToList();
            }

            if (StatusFilter is null)
            {
                return Snapshot.Units;
            }

            return Snapshot.Units.Where(u => u.Status == StatusFilter).ToList();
        }
    }

    private string FilterLabel => VacantMakeReadyMode
        ? "Vacant + Make-Ready"
        : StatusFilter ?? "All";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        LoadError = null;
        try
        {
            Snapshot = await DashboardService.GetSnapshotAsync();
            LoadedAtDisplay = DateTimeService.ToDisplayTime(DateTimeService.UtcNow).ToString("f");
        }
        catch (Exception ex)
        {
            Snapshot = null;
            LoadError = "Could not load dashboard. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleStatusFilter(string status)
    {
        VacantMakeReadyMode = false;
        StatusFilter = StatusFilter == status ? null : status;
    }

    private void ToggleVacantMakeReadyFilter()
    {
        if (VacantMakeReadyMode)
        {
            VacantMakeReadyMode = false;
            StatusFilter = null;
            return;
        }

        VacantMakeReadyMode = true;
        StatusFilter = null;
    }

    private void ClearFilter()
    {
        StatusFilter = null;
        VacantMakeReadyMode = false;
    }

    private static string CssStatusKey(string name) => name switch
    {
        "Occupied" => "occupied",
        "Vacant" => "vacant",
        "Make-Ready" => "makeready",
        "Maintenance" => "maintenance",
        _ => "other",
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        "Occupied" => "text-bg-success",
        "Vacant" => "text-bg-secondary",
        "Make-Ready" => "text-bg-info",
        "Maintenance" => "text-bg-warning",
        _ => "text-bg-light",
    };
}
