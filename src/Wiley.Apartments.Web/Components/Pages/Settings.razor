@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Grids
@using Wiley.Apartments.Contracts
@using Wiley.Apartments.Domain
@using Wiley.Apartments.Web.Configuration
@inject IJSRuntime JsRuntime
@inject ClerkSuiteThemeState ThemeState
@inject ILateFeeSettingsService LateFeeSettings
@inject IFacilityRentalRateService CcRates
@inject ILedgerService LedgerService
@inject IDocumentPathResolver DocumentPaths
@inject IDemoDataSeeder DemoSeeder
@inject IClerkToast Toast
@inject AuthenticationStateProvider AuthState
@inject Microsoft.Extensions.Options.IOptions<ClerkSuiteOptions> ClerkOptions
@inject IHostEnvironment HostEnvironment
@inject ILogger<Settings> Logger
@using Microsoft.Extensions.Hosting
@implements IDisposable

<PageTitle>Settings</PageTitle>

<PageHeader Title="Settings" Subtitle="Appearance, document storage on mr-storage, late fees, payment portal, and demo data." />

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-warning">@ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success">@SuccessMessage</div>
}

<section class="settings-panel e-card p-4 mb-4" aria-labelledby="appearance-heading">
    <h2 id="appearance-heading" class="h5 mb-3">Appearance</h2>
    <p class="text-muted mb-4">
        Choose Fluent light or dark for Syncfusion controls and the ClerkSuite shell.
        Your preference is saved in this browser.
    </p>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="@ThemeLabelClass(false)">Light</span>
        <SfSwitch @bind-Checked="IsDarkMode"
                  TChecked="bool"
                  CssClass="clerksuite-theme-switch"
                  ValueChange="OnThemeChangedAsync" />
        <span class="@ThemeLabelClass(true)">Dark</span>
    </div>
</section>

<section class="settings-panel e-card p-4 mb-4" aria-labelledby="docs-heading">
    <h2 id="docs-heading" class="h5 mb-3">Document storage (mr-storage)</h2>
    <p class="text-muted mb-3">
        Vault files live on the NAS under this folder (leases, templates, uploads, appliances, community-center).
        Default comes from deploy env <code>ClerkSuite__DocumentRoot</code> / compose mount
        (usually <code>/docs</code> in the container → <code>/volume1/apartments/docs</code> on the NAS).
        Change here only when IT moves the share; the app creates the folder if missing and checks write access.
    </p>
    <div class="row g-3" style="max-width: 720px;">
        <div class="col-12">
            <label class="form-label">Document root path</label>
            <SfTextBox @bind-Value="DocumentRootPath"
                       Placeholder="/docs or /volume1/apartments/docs"
                       HtmlAttributes="@(new Dictionary<string, object> { ["spellcheck"] = "false" })" />
            <div class="form-text">
                Configured default: <code>@DocumentPaths.ConfiguredDefaultRoot</code>
                · Effective now: <code>@EffectiveDocumentRoot</code>
            </div>
        </div>
        <div class="col-12">
            <p class="small text-muted mb-2">Standard subfolders (relative to root — do not rename casually):</p>
            <ul class="small mb-0">
                <li><code>templates/</code> — lease PDF templates</li>
                <li><code>leases/</code> — generated & signed leases</li>
                <li><code>uploads/</code> — general uploads</li>
                <li><code>appliances/</code> — manuals / warranties</li>
                <li><code>community-center/</code> — CC rental agreements & renter packets</li>
                <li><code>tenants/</code> — screening & tenant docs</li>
            </ul>
        </div>
        <div class="col-12 d-flex gap-2 flex-wrap">
            <SfButton CssClass="e-primary e-small" Content="Save document path" Disabled="@Busy" OnClick="SaveDocumentRootAsync" />
            <SfButton CssClass="e-outline e-small" Content="Reset to deploy default" Disabled="@Busy" OnClick="ResetDocumentRootAsync" />
        </div>
    </div>
</section>

<section class="settings-panel e-card p-4 mb-4" aria-labelledby="latefee-heading">
    <h2 id="latefee-heading" class="h5 mb-3">Late fees (G2)</h2>
    <p class="text-muted mb-3">
        Default <strong>off</strong>. When enabled, clerks can assess a flat late fee for tenant/unit
        balances past the grace period (one assessment per calendar month).
    </p>
    <div class="row g-3" style="max-width: 560px;">
        <div class="col-12 d-flex align-items-center gap-3">
            <SfSwitch @bind-Checked="LateFeesEnabled" TChecked="bool" />
            <span>@(LateFeesEnabled ? "Enabled" : "Disabled")</span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Amount</label>
            <SfNumericTextBox TValue="decimal" @bind-Value="LateFeeAmount" Format="C2" Min="0" Disabled="@(!LateFeesEnabled)" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Grace days</label>
            <SfNumericTextBox TValue="int" @bind-Value="LateFeeGraceDays" Min="0" Disabled="@(!LateFeesEnabled)" />
        </div>
        <div class="col-12 d-flex gap-2 flex-wrap">
            <SfButton CssClass="e-primary e-small" Content="Save late-fee settings" Disabled="@Busy" OnClick="SaveLateFeesAsync" />
            <SfButton CssClass="e-outline e-small" Content="Assess late fees now" Disabled="@(Busy || !LateFeesEnabled)" OnClick="AssessLateFeesAsync" />
        </div>
    </div>
</section>

<section class="settings-panel e-card p-4 mb-4" aria-labelledby="ccrates-heading">
    <h2 id="ccrates-heading" class="h5 mb-3">Community Center rates</h2>
    <p class="text-muted mb-3">
        Default fee and deposit for Fireplace Room, Kitchen, Hall, and Entire Facility.
        Clerks pick these on a reservation, then can change the dollar amount for that booking.
        Hover the Space/Rate labels on Community Center → Reservations for details.
    </p>
    <SfGrid TValue="FacilityRentalRate" DataSource="@CcRateRows" AllowPaging="false" Height="280"
            Toolbar="@(new List<string> { "Edit", "Update", "Cancel" })">
        <GridEditSettings AllowEditing="true" Mode="EditMode.Normal" />
        <GridEvents TValue="FacilityRentalRate" OnActionBegin="OnCcRateActionBeginAsync" />
        <GridColumns>
            <GridColumn Field="@nameof(FacilityRentalRate.Id)" IsPrimaryKey="true" Visible="false" />
            <GridColumn Field="@nameof(FacilityRentalRate.Name)" HeaderText="Rate name" Width="180" />
            <GridColumn Field="@nameof(FacilityRentalRate.Space)" HeaderText="Space" Width="150" AllowEditing="false" />
            <GridColumn Field="@nameof(FacilityRentalRate.Fee)" HeaderText="Fee" Format="C2" Width="110" />
            <GridColumn Field="@nameof(FacilityRentalRate.Deposit)" HeaderText="Deposit" Format="C2" Width="110" />
            <GridColumn Field="@nameof(FacilityRentalRate.SortOrder)" HeaderText="Order" Width="80" />
            <GridColumn Field="@nameof(FacilityRentalRate.IsActive)" HeaderText="Active" Width="90" DisplayAsCheckBox="true" EditType="EditType.BooleanEdit" />
        </GridColumns>
    </SfGrid>
</section>

<section class="settings-panel e-card p-4 mb-4" aria-labelledby="portal-heading">
    <h2 id="portal-heading" class="h5 mb-3">Payment portal (G3 / PayStar)</h2>
    <p class="text-muted mb-2">
        Staff deep-link only — no card data in ClerkSuite. Configure via
        <code>ClerkSuite__PaymentPortalUrl</code> / <code>PaymentPortalUrl</code> env.
        Demo payments use method <strong>Online reference</strong> with PayStar confirmation notes.
    </p>
    @if (PortalConfigured)
    {
        <p class="mb-0">
            <a href="@PortalUrl" target="_blank" rel="noopener noreferrer">@PortalUrl</a>
        </p>
    }
    else
    {
        <div class="alert alert-warning mb-0">@PortalError</div>
    }
</section>

<section class="settings-panel e-card p-4 mb-4" aria-labelledby="demo-heading">
    <h2 id="demo-heading" class="h5 mb-3">Demo portfolio (pseudo residents)</h2>
    <p class="text-muted mb-3">
        Loads a full validation dataset: <strong>Jordan Reyes</strong> on Unit 1 with prior Unit 2 history,
        household/vehicles/pets, assets/flooring, active lease, signed PDF stubs, 24 months of rent charges
        and payments (cash/check/PayStar), maintenance, schedule, ops costs; plus <strong>five Community Center
        event renters</strong> with agreements, deposits, PayStar-style payments, and schedule.
        Marked with <code>[DEMO]</code> / <code>[DEMO-CC]</code> so they can be wiped safely.
    </p>
    @if (HostEnvironment.IsProduction())
    {
        <div class="alert alert-warning py-2">
            Production environment: demo load is available for recovery training only.
            <strong>Force reseed (wipe)</strong> is disabled here to protect live portfolio data.
        </div>
    }
    <div class="d-flex gap-2 flex-wrap mb-3">
        <SfButton CssClass="e-primary e-small" Content="Load demo data" Disabled="@Busy" OnClick="@(() => RunDemoAsync(false))" />
        @if (!HostEnvironment.IsProduction())
        {
            <SfButton CssClass="e-outline e-small" Content="Force reseed (wipe demo first)" Disabled="@Busy" OnClick="@(() => RunDemoAsync(true))" />
        }
        <SfButton CssClass="e-outline e-small" Content="Validate demo against backend" Disabled="@Busy" OnClick="ValidateDemoAsync" />
    </div>
    @if (LastSeed is not null)
    {
        <div class="border rounded p-3 mb-3 small">
            <strong>Last seed:</strong> @LastSeed.Message<br />
            Primary: @LastSeed.PrimaryTenantName
            · CC renters: @LastSeed.CommunityCenterRenters
            · Ledger lines: @LastSeed.LedgerEntries
            · Docs: @LastSeed.Documents
            · Maintenance: @LastSeed.Maintenance
            · Schedule: @LastSeed.ScheduleItems
        </div>
    }
    @if (Validation is not null)
    {
        <div class="border rounded p-3">
            <p class="mb-2">
                <strong>Validation:</strong>
                @if (Validation.Pass)
                {
                    <span class="text-success">PASS</span>
                }
                else
                {
                    <span class="text-danger">FAIL</span>
                }
            </p>
            <ul class="mb-0 small">
                @foreach (var c in Validation.Checks)
                {
                    <li>
                        @(c.Pass ? "✓" : "✗") <strong>@c.Area</strong> — @c.Detail
                        @if (c.Count > 0)
                        {
                            <span class="text-muted">(@c.Count)</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</section>

@code {
    private bool IsDarkMode { get; set; }
    private bool _themeLoaded;
    private bool LateFeesEnabled { get; set; }
    private decimal LateFeeAmount { get; set; }
    private int LateFeeGraceDays { get; set; }
    private List<FacilityRentalRate> CcRateRows { get; set; } = [];
    private bool Busy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string DocumentRootPath { get; set; } = "";
    private string EffectiveDocumentRoot { get; set; } = "";
    private DemoSeedResult? LastSeed { get; set; }
    private DemoValidationReport? Validation { get; set; }

    private bool PortalConfigured =>
        PaymentPortalConfiguration.TryResolve(ClerkOptions.Value.PaymentPortalUrl, out _, out _);
    private string PortalUrl =>
        PaymentPortalConfiguration.TryResolve(ClerkOptions.Value.PaymentPortalUrl, out var url, out _)
            ? url
            : string.Empty;
    private string PortalError =>
        PaymentPortalConfiguration.TryResolve(ClerkOptions.Value.PaymentPortalUrl, out _, out var err)
            ? string.Empty
            : (err ?? PaymentPortalConfiguration.ItContactNote);

    protected override void OnInitialized()
    {
        ThemeState.Changed += OnThemeStateChanged;
        IsDarkMode = ThemeState.IsDark;
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await LateFeeSettings.GetAsync();
        LateFeesEnabled = settings.Enabled;
        LateFeeAmount = settings.Amount;
        LateFeeGraceDays = settings.GraceDays;
        CcRateRows = (await CcRates.ListAsync(includeInactive: true)).ToList();
        EffectiveDocumentRoot = await DocumentPaths.GetDocumentRootAsync();
        DocumentRootPath = EffectiveDocumentRoot;
        if (await DemoSeeder.IsDemoLoadedAsync())
        {
            LastSeed = await DemoSeeder.SeedAsync(force: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsDarkMode = await JsRuntime.InvokeAsync<bool>("ClerkSuiteTheme.isDarkMode");
            _themeLoaded = true;
            ThemeState.SetDark(IsDarkMode);
            StateHasChanged();
        }
    }

    private async Task OnThemeChangedAsync(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        if (!_themeLoaded)
        {
            return;
        }

        IsDarkMode = args.Checked;
        ThemeState.SetDark(IsDarkMode);
        await JsRuntime.InvokeVoidAsync("ClerkSuiteTheme.setDarkMode", IsDarkMode);
    }

    private void OnThemeStateChanged()
    {
        IsDarkMode = ThemeState.IsDark;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeState.Changed -= OnThemeStateChanged;

    private string ThemeLabelClass(bool forDark) =>
        forDark == IsDarkMode ? "fw-semibold" : "text-muted";

    private async Task SaveDocumentRootAsync()
    {
        Busy = true;
        ErrorMessage = null;
        SuccessMessage = null;
        try
        {
            var user = await CurrentUserAsync();
            await DocumentPaths.SetDocumentRootAsync(DocumentRootPath, user);
            EffectiveDocumentRoot = await DocumentPaths.GetDocumentRootAsync();
            DocumentRootPath = EffectiveDocumentRoot;
            SuccessMessage = $"Document storage path saved: {EffectiveDocumentRoot}";
            await Toast.ShowSuccessAsync("Document path saved.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Settings operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ResetDocumentRootAsync()
    {
        DocumentRootPath = DocumentPaths.ConfiguredDefaultRoot;
        await SaveDocumentRootAsync();
    }

    private async Task SaveLateFeesAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            var saved = await LateFeeSettings.UpdateAsync(LateFeesEnabled, LateFeeAmount, LateFeeGraceDays);
            LateFeesEnabled = saved.Enabled;
            LateFeeAmount = saved.Amount;
            LateFeeGraceDays = saved.GraceDays;
            await Toast.ShowSuccessAsync("Late-fee settings saved.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Settings operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task OnCcRateActionBeginAsync(Syncfusion.Blazor.Grids.ActionEventArgs<FacilityRentalRate> args)
    {
        if (args.RequestType != Syncfusion.Blazor.Grids.Action.Save || args.Data is null)
        {
            return;
        }

        try
        {
            await CcRates.UpsertAsync(args.Data);
            CcRateRows = (await CcRates.ListAsync(includeInactive: true)).ToList();
            await Toast.ShowSuccessAsync("Community Center rate saved.");
        }
        catch (Exception ex)
        {
            args.Cancel = true;
            Logger.LogError(ex, "Settings CC rate save failed.");
            ErrorMessage = ex.Message;
        }
    }

    private async Task AssessLateFeesAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            await LateFeeSettings.UpdateAsync(LateFeesEnabled, LateFeeAmount, LateFeeGraceDays);
            var count = await LedgerService.ApplyLateFeesAsync();
            await Toast.ShowSuccessAsync(count == 0
                ? "No late fees assessed (none eligible or already assessed this month)."
                : $"Posted {count} late-fee charge(s).");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Settings operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RunDemoAsync(bool force)
    {
        if (force && HostEnvironment.IsProduction())
        {
            ErrorMessage = "Force reseed is disabled in Production.";
            await Toast.ShowErrorAsync("Force reseed is disabled in Production.");
            return;
        }

        Busy = true;
        ErrorMessage = null;
        SuccessMessage = null;
        Validation = null;
        try
        {
            LastSeed = await DemoSeeder.SeedAsync(force);
            SuccessMessage = LastSeed.Message;
            await Toast.ShowSuccessAsync(LastSeed.AlreadyLoaded && !force
                ? "Demo already present."
                : "Demo portfolio loaded.");
            Validation = await DemoSeeder.ValidateAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Settings operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ValidateDemoAsync()
    {
        Busy = true;
        ErrorMessage = null;
        try
        {
            Validation = await DemoSeeder.ValidateAsync();
            await Toast.ShowSuccessAsync(Validation.Pass
                ? "All demo validation checks passed."
                : "Validation found issues — see checklist.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Settings operation failed.");
            ErrorMessage = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task<string> CurrentUserAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.Email)
            ?? state.User.Identity?.Name
            ?? "clerk";
    }
}
