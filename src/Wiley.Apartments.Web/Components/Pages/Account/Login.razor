@page "/Account/Login"
@layout EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@using Wiley.Apartments.Web.Infrastructure

<PageTitle>Sign in — ClerkSuite</PageTitle>

<div class="login-panel mx-auto mt-5" style="max-width: 420px;">
    <h2>ClerkSuite</h2>
    <p class="text-muted">Sign in to continue.</p>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @* Static SSR form — Identity cookie sign-in must run outside Interactive Server circuit. *@
    <EditForm Model="Input" FormName="login" method="post" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText @bind-Value="Input.Email" class="form-control" placeholder="you@townofwiley.gov" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText @bind-Value="Input.Password" type="password" class="form-control" />
        </div>
        <SfButton CssClass="e-primary"
                  IsPrimary="true"
                  Content="Sign in"
                  HtmlAttributes="@SubmitButtonAttributes" />
    </EditForm>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    public LoginInput Input { get; set; } = new();

    private string? ErrorMessage { get; set; }

    private static Dictionary<string, object> SubmitButtonAttributes { get; } =
        new() { ["type"] = "submit" };

    private async Task HandleLoginAsync()
    {
        ErrorMessage = null;
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email,
            Input.Password,
            isPersistent: true,
            lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Navigation.NavigateTo(
                LoginRedirectHelper.GetSafeReturnUrl(ReturnUrl),
                forceLoad: true);
            return;
        }

        ErrorMessage = "Invalid email or password.";
    }

    public sealed class LoginInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
