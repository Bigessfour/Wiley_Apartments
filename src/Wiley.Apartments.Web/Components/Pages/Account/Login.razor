@page "/Account/Login"
@layout EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Cards
@using Wiley.Apartments.Web.Infrastructure

<PageTitle>Sign in — ClerkSuite</PageTitle>

<main class="login-shell">
    <SfCard CssClass="login-panel">
        <CardContent>
            <div class="login-mark" aria-hidden="true">CS</div>
            <h1>ClerkSuite</h1>
            <p class="login-lead">Sign in on ClerkSuite</p>
            <SfButton CssClass="e-primary" HtmlAttributes="@SignInLink">Sign in on ClerkSuite</SfButton>
        </CardContent>
    </SfCard>
</main>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private Dictionary<string, object> SignInLink => new()
    {
        ["href"] = "/authentication/cognito-login?return="
            + Uri.EscapeDataString(LoginRedirectHelper.GetSafeReturnUrl(ReturnUrl))
    };
}
