@page "/Error"
@layout EmptyLayout
@using System.Diagnostics

<PageTitle>Something went wrong — ClerkSuite</PageTitle>

<div class="login-shell">
    <div class="login-panel e-card" style="max-width: 28rem;">
        <div class="e-card-content p-4">
            <div class="login-mark" aria-hidden="true">CS</div>
            <h1 class="h3">Something went wrong</h1>
            <p class="text-muted">
                ClerkSuite hit an unexpected error. Your data is usually safe — try again from the dashboard.
            </p>
            @if (ShowRequestId)
            {
                <p class="small">
                    <strong>Request ID:</strong> <code>@RequestId</code>
                    <span class="text-muted"> (share with IT if it keeps happening)</span>
                </p>
            }
            <p class="mb-3">
                <a class="e-btn e-primary" href="/">Back to dashboard</a>
                <a class="e-btn e-outline ms-2" href="/Account/Login">Sign in</a>
            </p>
            <p class="small text-muted mb-0">
                If this repeats after refresh, check <code>logs/clerksuite-*.log</code> on the server or contact IT.
            </p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
