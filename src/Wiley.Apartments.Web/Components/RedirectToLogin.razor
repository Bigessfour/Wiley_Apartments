@using Wiley.Apartments.Web.Infrastructure
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var path = LoginRedirectHelper.FromBaseRelativePath(
            Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo(
            $"/Account/Login?ReturnUrl={Uri.EscapeDataString(path)}",
            forceLoad: true);
    }
}
