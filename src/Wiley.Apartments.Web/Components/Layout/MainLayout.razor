@inherits LayoutComponentBase
@using Syncfusion.Blazor.Navigations

<div class="clerksuite-shell">
    <SfSidebar @bind-IsOpen="SidebarOpen" Width="260px" Type="SidebarType.Over" ShowBackdrop="true">
        <ChildContent>
            <div class="clerksuite-brand px-3 py-3">
                <strong>ClerkSuite</strong>
                <div class="text-muted small">Town of Wiley Apartments</div>
            </div>
            <nav class="clerksuite-nav px-2">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink class="nav-link" href="units">Units</NavLink>
                <NavLink class="nav-link" href="tenants">Tenants</NavLink>
                <NavLink class="nav-link" href="leases">Leases</NavLink>
                <NavLink class="nav-link" href="payments">Payments</NavLink>
                <NavLink class="nav-link" href="schedule">Schedule</NavLink>
                <NavLink class="nav-link" href="maintenance">Maintenance</NavLink>
                <NavLink class="nav-link" href="reports">Reports</NavLink>
                <NavLink class="nav-link" href="audit">Audit</NavLink>
                <NavLink class="nav-link" href="settings">Settings</NavLink>
                <NavLink class="nav-link" href="Account/Logout">Sign out</NavLink>
            </nav>
        </ChildContent>
    </SfSidebar>

    <div class="clerksuite-main">
        <header class="clerksuite-header px-3 py-2 d-flex align-items-center gap-2">
            <SfButton CssClass="e-flat" IconCss="e-icons e-menu" OnClick="ToggleSidebar" />
            <span class="fw-semibold">Wiley Apartments</span>
        </header>
        <main class="clerksuite-content px-4 py-3">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool SidebarOpen { get; set; }

    private void ToggleSidebar() => SidebarOpen = !SidebarOpen;
}
