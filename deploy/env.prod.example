# Copy to deploy/.env.prod and fill values. Never commit .env.prod.
#
# Aurora / RDS Postgres (Town of Wiley — prefer profile tow, us-east-2)

ASPNETCORE_ENVIRONMENT=Production
CLERKSUITE_VERSION=latest
CLERKSUITE_HOST_PORT=8082

# Required for docker-compose.prod.yml
ClerkSuite__DatabaseProvider=Postgres

# Npgsql connection string — SSL required for Aurora
# Example:
# Host=clerksuite.cluster-xxxx.us-east-2.rds.amazonaws.com;Port=5432;Database=clerksuite;Username=clerksuite;Password=***;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=REPLACE_AURORA_ENDPOINT;Port=5432;Database=clerksuite;Username=REPLACE_USER;Password=REPLACE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

ClerkSuite__DocumentRoot=/docs
DOCUMENTS_HOST_PATH=/volume1/apartments/docs
# Data volume is for ASP.NET Data Protection keys when not using SQLite
DATA_HOST_PATH=/volume1/apartments/dpkeys

SYNCFUSION_LICENSE_KEY=
ClerkSuite__PaymentPortalUrl=https://www.townofwiley.gov/government/departments/finance/utility-billing
ClerkSuite__LateFeesEnabled=false
