# Copy to /volume1/docker/clerksuite/.env on the NAS (chmod 600).
# Never commit real values. Prefer scripts/deploy-to-nas.sh to create this from Keychain.

DOCUMENTS_HOST_PATH=/volume1/apartments/docs
SYNCFUSION_LICENSE_KEY=
# Town PayStar deep-link (G3 / T4.3) — maps to ClerkSuite__PaymentPortalUrl
PaymentPortalUrl=https://www.townofwiley.gov/government/departments/finance/utility-billing
# Optional late-fee defaults (G2); runtime toggle lives in Settings → Late fees
ClerkSuite__LateFeesEnabled=false
ClerkSuite__LateFeeAmount=0
ClerkSuite__LateFeeGraceDays=0

# Document vault root inside container (Settings can override at runtime)
# ClerkSuite__DocumentRoot=/docs

# Shared clerk Identity login (created once on container start if missing)
# SeedUsers__Users__0__Email=clerk@townofwiley.gov
# SeedUsers__Users__0__Password=
# SeedUsers__Users__0__DisplayName=Town Clerk
